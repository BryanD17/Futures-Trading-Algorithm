strategy("LucidICT V6", shorttitle = "LucidICT_v6", overlay = true, pyramiding = 0, process_orders_on_close = true, calc_on_every_tick = false, calc_on_order_fills = false, initial_capital = 50000, currency = currency.USD, default_qty_type = strategy.fixed, default_qty_value = 1, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 100, max_bars_back = 500)
