// ---- [Account] (Agent 03, task 03.4 / I7): AccountProfile dropdown + CUSTOM numbers. The block below
// is GENERATED by tools/pine_build.py from config/lucid_profiles.yaml (AP-5: no plan number in pine/src).
// It defines i_profile, i_c* (CUSTOM inputs), V6_HARD_NO_ENTRY_HHMM / V6_HARD_FLATTEN_HHMM (I3 outer
// limits from common.v6_*) and the accessors apMaxMicros / apScalingCap / apSoftDailyLoss /
// apDrawdownBuffer / apStartBalance / apMll / apLockedFloor (string profile [, float profit]).
// ---- GENERATED by tools/pine_build.py from config/lucid_profiles.yaml. Do not hand-edit (AP-5).
// drawdownBuffer$ = profile key v6_drawdown_buffer_usd, else 10% of that profile's YAML MLL
// (CONSERVATIVE-UNVERIFIED). softDailyLoss$ = v6_soft_daily_loss_usd (CONSERVATIVE-UNVERIFIED, OA-7).
const int V6_HARD_NO_ENTRY_HHMM = 1630   // common.v6_no_entry_after_et (I3 outer limit)
const int V6_HARD_FLATTEN_HHMM  = 1640   // common.v6_flatten_at_et (I3 outer limit)
i_profile = input.string("LUCID_FLEX_50K_EVAL", "Plan profile", options = ["LUCID_FLEX_50K_EVAL", "LUCID_FLEX_50K_FUNDED", "LUCID_FLEX_25K_EVAL", "LUCID_FLEX_25K_FUNDED", "LUCID_FLEX_100K_EVAL", "LUCID_FLEX_100K_FUNDED", "LUCID_FLEX_150K_EVAL", "LUCID_FLEX_150K_FUNDED", "CUSTOM"], group = G_ACCOUNT, tooltip = "AccountProfile (I7). Sets ONLY the caps (maxContracts, scalingCap) and the soft loss limits (softDailyLoss$, drawdownBuffer$, EOD-trailing MLL emulation). Entry logic never reads it. CUSTOM = the raw numbers below.")
i_cMaxMicros   = input.int(40, "CUSTOM maxContracts (micros)", minval = 0, group = G_ACCOUNT, tooltip = "CUSTOM only. Micro-equivalents: 1 mini = 10 micros.")
i_cScaleMicros = input.int(40, "CUSTOM scalingCap (micros)", minval = 0, group = G_ACCOUNT, tooltip = "CUSTOM only.")
i_cSoftDL      = input.float(600.0, "CUSTOM softDailyLoss$", minval = 1, group = G_ACCOUNT, tooltip = "CUSTOM only. strategy.risk.max_intraday_loss + the Pine soft daily stop.")
i_cDDBuffer    = input.float(200.0, "CUSTOM drawdownBuffer$", minval = 0, group = G_ACCOUNT, tooltip = "CUSTOM only. No entry when MLL room minus this trade's risk would fall below this.")
i_cStartBal    = input.float(50000.0, "CUSTOM starting balance$", minval = 0, group = G_ACCOUNT, tooltip = "CUSTOM only.")
i_cMll         = input.float(2000.0, "CUSTOM MLL$ (EOD trailing, 0 = off)", minval = 0, group = G_ACCOUNT, tooltip = "CUSTOM only.")
i_cLockFloor   = input.float(50100.0, "CUSTOM locked MLL floor$", minval = 0, group = G_ACCOUNT, tooltip = "CUSTOM only. The trailing floor never rises above this.")
apMaxMicros(simple string p) =>
    p == "LUCID_FLEX_50K_EVAL" ? 40 : p == "LUCID_FLEX_50K_FUNDED" ? 40 : p == "LUCID_FLEX_25K_EVAL" ? 20 : p == "LUCID_FLEX_25K_FUNDED" ? 20 : p == "LUCID_FLEX_100K_EVAL" ? 60 : p == "LUCID_FLEX_100K_FUNDED" ? 60 : p == "LUCID_FLEX_150K_EVAL" ? 100 : p == "LUCID_FLEX_150K_FUNDED" ? 100 : i_cMaxMicros
apScalingCapBase(simple string p) =>
    p == "LUCID_FLEX_50K_EVAL" ? 40 : p == "LUCID_FLEX_50K_FUNDED" ? 20 : p == "LUCID_FLEX_25K_EVAL" ? 20 : p == "LUCID_FLEX_25K_FUNDED" ? 10 : p == "LUCID_FLEX_100K_EVAL" ? 60 : p == "LUCID_FLEX_100K_FUNDED" ? 30 : p == "LUCID_FLEX_150K_EVAL" ? 100 : p == "LUCID_FLEX_150K_FUNDED" ? 40 : i_cScaleMicros
apSoftDailyLoss(simple string p) =>
    p == "LUCID_FLEX_50K_EVAL" ? 600.0 : p == "LUCID_FLEX_50K_FUNDED" ? 600.0 : p == "LUCID_FLEX_25K_EVAL" ? 300.0 : p == "LUCID_FLEX_25K_FUNDED" ? 300.0 : p == "LUCID_FLEX_100K_EVAL" ? 900.0 : p == "LUCID_FLEX_100K_FUNDED" ? 900.0 : p == "LUCID_FLEX_150K_EVAL" ? 1350.0 : p == "LUCID_FLEX_150K_FUNDED" ? 1350.0 : i_cSoftDL
apDrawdownBuffer(simple string p) =>
    p == "LUCID_FLEX_50K_EVAL" ? 200.0 : p == "LUCID_FLEX_50K_FUNDED" ? 200.0 : p == "LUCID_FLEX_25K_EVAL" ? 100.0 : p == "LUCID_FLEX_25K_FUNDED" ? 100.0 : p == "LUCID_FLEX_100K_EVAL" ? 300.0 : p == "LUCID_FLEX_100K_FUNDED" ? 300.0 : p == "LUCID_FLEX_150K_EVAL" ? 450.0 : p == "LUCID_FLEX_150K_FUNDED" ? 450.0 : i_cDDBuffer
apStartBalance(simple string p) =>
    p == "LUCID_FLEX_50K_EVAL" ? 50000.0 : p == "LUCID_FLEX_50K_FUNDED" ? 50000.0 : p == "LUCID_FLEX_25K_EVAL" ? 25000.0 : p == "LUCID_FLEX_25K_FUNDED" ? 25000.0 : p == "LUCID_FLEX_100K_EVAL" ? 100000.0 : p == "LUCID_FLEX_100K_FUNDED" ? 100000.0 : p == "LUCID_FLEX_150K_EVAL" ? 150000.0 : p == "LUCID_FLEX_150K_FUNDED" ? 150000.0 : i_cStartBal
apMll(simple string p) =>
    p == "LUCID_FLEX_50K_EVAL" ? 2000.0 : p == "LUCID_FLEX_50K_FUNDED" ? 2000.0 : p == "LUCID_FLEX_25K_EVAL" ? 1000.0 : p == "LUCID_FLEX_25K_FUNDED" ? 1000.0 : p == "LUCID_FLEX_100K_EVAL" ? 3000.0 : p == "LUCID_FLEX_100K_FUNDED" ? 3000.0 : p == "LUCID_FLEX_150K_EVAL" ? 4500.0 : p == "LUCID_FLEX_150K_FUNDED" ? 4500.0 : i_cMll
apLockedFloor(simple string p) =>
    p == "LUCID_FLEX_50K_EVAL" ? 50100.0 : p == "LUCID_FLEX_50K_FUNDED" ? 50100.0 : p == "LUCID_FLEX_25K_EVAL" ? 25100.0 : p == "LUCID_FLEX_25K_FUNDED" ? 25100.0 : p == "LUCID_FLEX_100K_EVAL" ? 100100.0 : p == "LUCID_FLEX_100K_FUNDED" ? 100100.0 : p == "LUCID_FLEX_150K_EVAL" ? 150100.0 : p == "LUCID_FLEX_150K_FUNDED" ? 150100.0 : i_cLockFloor
// Scaling plan (funded profiles): micros allowed at EOD account profit `pr`; no plan -> scaling_cap_micros.
apScalingCap(simple string p, float pr) =>
    int v = apScalingCapBase(p)
    if p == "LUCID_FLEX_50K_FUNDED"
        v := pr >= 2000.0 ? 40 : pr >= 1000.0 ? 30 : 20
    else if p == "LUCID_FLEX_25K_FUNDED"
        v := pr >= 1000.0 ? 20 : 10
    else if p == "LUCID_FLEX_100K_FUNDED"
        v := pr >= 3000.0 ? 60 : pr >= 2000.0 ? 50 : pr >= 1000.0 ? 40 : 30
    else if p == "LUCID_FLEX_150K_FUNDED"
        v := pr >= 4500.0 ? 100 : pr >= 3000.0 ? 80 : pr >= 2000.0 ? 60 : pr >= 1000.0 ? 50 : 40
    v
i_haltAtProfit = input.float(0.0, "haltAtProfit$ (0 = off)", minval = 0, group = G_ACCOUNT, tooltip = "Optional (PORT_MAP S7, Java risk.haltOnProfitTarget): no NEW entries once closed account profit >= this. 0 = off; the eval target is the owner's decision.")

