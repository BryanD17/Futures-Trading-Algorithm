// ==== file: 20_time.pine ====
// =============================================================================
// 20_time — ET clock, SessionClassifier windows, killzones, Silver Bullet,
// trading-day / week keys. Every function takes a UNIX ms timestamp and reads the
// wall clock in "America/New_York" (DST-safe; R9 / AP-7). Never chart-timezone math.
// Java: strategy/session/SessionClassifier.java:57-83, chartstate/RaidQualityScorer.java:110
// =============================================================================
const string TZ = "America/New_York"
const int MS_MIN  = 60000
const int MS_HOUR = 3600000
const int MS_DAY  = 86400000

// SessionClassifier window codes (SessionClassifier.classify, :113)
const int SW_ASIA     = 1
const int SW_LONDON   = 2
const int SW_PRE_NY   = 3
const int SW_NY_AM    = 4
const int SW_NY_LUNCH = 5
const int SW_NY_PM    = 6
const int SW_NO_ENTRY = 7
const int SW_PRE_ASIA = 8
const int SW_WEEKEND  = 9

// HHMM (ET wall clock) -> minutes after midnight
hhmmToMin(int hhmm) =>
    math.floor(hhmm / 100) * 60 + hhmm % 100

// ET minutes after midnight of a timestamp
etMin(int t) =>
    hour(t, TZ) * 60 + minute(t, TZ)

// [start, end) in minutes; wraps midnight when start > end; empty when start == end
// (LevelEngine.inWindow semantics)
inWin(int m, int startMin, int endMin) =>
    startMin == endMin ? false : startMin < endMin ? (m >= startMin and m < endMin) : (m >= startMin or m < endMin)

inWinHHMM(int t, int startHHMM, int endHHMM) =>
    inWin(etMin(t), hhmmToMin(startHHMM), hhmmToMin(endHHMM))

// yyyymmdd of the ET calendar date of t
etDateKey(int t) =>
    year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

// CME trading day: rolls at 18:00 ET (a print at/after 18:00 belongs to the next date).
// +6 h maps 18:00..23:59 onto the next calendar date and leaves 00:00..17:59 on the same date.
tradingDayKey(int t) =>
    etDateKey(t + 6 * MS_HOUR)

// Week key = the Monday of the trading day's week (ISO week; Sunday 18:00 opens Monday)
weekKey(int t) =>
    int x = t + 6 * MS_HOUR
    int dow = dayofweek(x, TZ)
    int back = dow == dayofweek.sunday ? 6 : dow - dayofweek.monday
    etDateKey(x - back * MS_DAY)

// Inside the CME daily halt 17:00-18:00 ET (Java ignores these prints: DealingRangeTracker, LevelEngine)
inHalt(int t) =>
    int m = etMin(t)
    m >= 17 * 60 and m < 18 * 60

isWeekend(int t) =>
    int dow = dayofweek(t, TZ)
    int m = etMin(t)
    (dow == dayofweek.friday and m >= 17 * 60) or dow == dayofweek.saturday or (dow == dayofweek.sunday and m < 18 * 60)

// SessionClassifier.classify (ET): ASIA 19-02, LONDON 02-08, PRE_NY 08-09:30, NY_AM 09:30-12,
// NY_LUNCH 12-13:30, NY_PM 13:30-15:45, NO_ENTRY 15:45-18, PRE_ASIA 18-19, WEEKEND Fri 17 -> Sun 18
sessionWindow(int t) =>
    int m = etMin(t)
    int sw = SW_ASIA
    if isWeekend(t)
        sw := SW_WEEKEND
    else if inWin(m, 15 * 60 + 45, 18 * 60)
        sw := SW_NO_ENTRY
    else if inWin(m, 18 * 60, 19 * 60)
        sw := SW_PRE_ASIA
    else if inWin(m, 19 * 60, 2 * 60)
        sw := SW_ASIA
    else if inWin(m, 2 * 60, 8 * 60)
        sw := SW_LONDON
    else if inWin(m, 8 * 60, 9 * 60 + 30)
        sw := SW_PRE_NY
    else if inWin(m, 9 * 60 + 30, 12 * 60)
        sw := SW_NY_AM
    else if inWin(m, 12 * 60, 13 * 60 + 30)
        sw := SW_NY_LUNCH
    else
        sw := SW_NY_PM
    sw

sessionName(int sw) =>
    switch sw
        SW_ASIA     => "ASIA"
        SW_LONDON   => "LONDON"
        SW_PRE_NY   => "PRE_NY"
        SW_NY_AM    => "NY_AM"
        SW_NY_LUNCH => "NY_LUNCH"
        SW_NY_PM    => "NY_PM"
        SW_NO_ENTRY => "NO_ENTRY"
        SW_PRE_ASIA => "PRE_ASIA"
        SW_WEEKEND  => "WEEKEND"
        => "?"

// M3 (MandatoryConfluenceValidator:597): NO_ENTRY and WEEKEND always block
sessionBlocksEntry(int t) =>
    int sw = sessionWindow(t)
    sw == SW_NO_ENTRY or sw == SW_WEEKEND

// [Time] per-window allow toggles (session.allSessions = true -> all allowed by default)
sessionAllowed(int t) =>
    int sw = sessionWindow(t)
    switch sw
        SW_ASIA     => i_kzAsia
        SW_LONDON   => i_kzLondon
        SW_PRE_NY   => i_kzPreNy
        SW_NY_AM    => i_kzNyAm
        SW_NY_LUNCH => i_kzNyLunch
        SW_NY_PM    => i_kzNyPm
        SW_PRE_ASIA => i_kzPreAsia
        => false

// Prime killzones (tier O1 only): London 02-05, NY AM 09:45-11:00, NY PM 13:45-15:45
isPrimeKillzone(int t) =>
    int m = etMin(t)
    inWin(m, 2 * 60, 5 * 60) or inWin(m, 9 * 60 + 45, 11 * 60) or inWin(m, 13 * 60 + 45, 15 * 60 + 45)

// Raid-score killzone (+2): legacy NY KZ 09:45-12:30 / 13:45-16:00 (RaidQualityScorer, PORT_MAP T5)
isRaidKillzone(int t) =>
    int m = etMin(t)
    inWin(m, 9 * 60 + 45, 12 * 60 + 30) or inWin(m, 13 * 60 + 45, 16 * 60)

// Silver Bullet (+1): 03-04, 10-11, 14-15 ET
isSilverBullet(int t) =>
    int m = etMin(t)
    inWin(m, 3 * 60, 4 * 60) or inWin(m, 10 * 60, 11 * 60) or inWin(m, 14 * 60, 15 * 60)

// ---- [Time] gates exposed to Agent 03 (I3). Times are ET.
// No new entry at/after noEntryAfter until the 18:00 ET reopen.
isNoEntryTime(int t) =>
    inWin(etMin(t), hhmmToMin(i_noEntryAfter), 18 * 60)

isFlattenTime(int t) =>
    int lim = dayofweek(t, TZ) == dayofweek.friday ? math.min(hhmmToMin(i_flattenAt), hhmmToMin(i_fridayFlatAt)) : hhmmToMin(i_flattenAt)
    inWin(etMin(t), lim, 18 * 60)

// Manual blackout windows (parsed once)
var array<int> blackoutStart = array.new<int>()
var array<int> blackoutEnd   = array.new<int>()
if barstate.isfirst and str.length(i_blackout) > 0
    array<string> parts = str.split(i_blackout, ",")
    for p in parts
        array<string> se = str.split(str.trim(p), "-")
        if se.size() == 2
            float s = str.tonumber(str.trim(se.get(0)))
            float e = str.tonumber(str.trim(se.get(1)))
            if not na(s) and not na(e)
                blackoutStart.push(hhmmToMin(int(s)))
                blackoutEnd.push(hhmmToMin(int(e)))

inManualBlackout(int t) =>
    bool hit = false
    int m = etMin(t)
    int nb = blackoutStart.size()
    if nb > 0
        for k = 0 to nb - 1
            if inWin(m, blackoutStart.get(k), blackoutEnd.get(k))
                hit := true
    hit
// ==== file: 30_levels.pine ====
// =============================================================================
// 30_levels — known liquidity levels (Java chartstate/LevelEngine.java).
// PDH/PDL (day rolls 18:00 ET, days < levels.minBarsPerDay ignored), PWH/PWL,
// ASIA / LONDON / NY_AM / NY_PM / NY session H/L (registered when the window ends),
// EQUAL_HIGH / EQUAL_LOW clusters (tick tolerance). A raided level re-arms once price
// leaves it by levels.rearmDistanceTicks. OPEN prices are never raided (not stored).
// Built from the 1m feed (request.security_lower_tf, see 70) exactly like Java, which
// builds them from 1m candles; no HTF request is needed (and none can repaint).
// =============================================================================
TICK = syminfo.mintick

// Java Math.round(p / tick) * tick (half-up), PORT_MAP O7
roundTick(float p) =>
    na(p) ? na : math.floor(p / TICK + 0.5) * TICK

// LevelType ids + significance (chartstate/LevelType.java)
const int LV_PDH       = 0
const int LV_PDL       = 1
const int LV_PWH       = 2
const int LV_PWL       = 3
const int LV_ASIA_H    = 4
const int LV_ASIA_L    = 5
const int LV_LONDON_H  = 6
const int LV_LONDON_L  = 7
const int LV_NYAM_H    = 8
const int LV_NYAM_L    = 9
const int LV_NYPM_H    = 10
const int LV_NYPM_L    = 11
const int LV_EQH       = 12
const int LV_EQL       = 13
const int LV_NY_H      = 14
const int LV_NY_L      = 15
const int LV_COUNT     = 16
const int LV_SESSION_H = 16   // synthetic: swing-sweep prior extreme (RaidDetector.scoreSweep)
const int LV_SESSION_L = 17

levelName(int k) =>
    switch k
        LV_PDH       => "PDH"
        LV_PDL       => "PDL"
        LV_PWH       => "PWH"
        LV_PWL       => "PWL"
        LV_ASIA_H    => "ASIA_HIGH"
        LV_ASIA_L    => "ASIA_LOW"
        LV_LONDON_H  => "LONDON_HIGH"
        LV_LONDON_L  => "LONDON_LOW"
        LV_NYAM_H    => "NY_AM_HIGH"
        LV_NYAM_L    => "NY_AM_LOW"
        LV_NYPM_H    => "NY_PM_HIGH"
        LV_NYPM_L    => "NY_PM_LOW"
        LV_EQH       => "EQUAL_HIGH"
        LV_EQL       => "EQUAL_LOW"
        LV_NY_H      => "NY_HIGH"
        LV_NY_L      => "NY_LOW"
        LV_SESSION_H => "SESSION_HIGH"
        LV_SESSION_L => "SESSION_LOW"
        => "?"

levelSignificance(int k) =>
    switch k
        LV_PDH       => 10
        LV_PDL       => 10
        LV_PWH       => 9
        LV_PWL       => 9
        LV_ASIA_H    => 7
        LV_ASIA_L    => 7
        LV_LONDON_H  => 7
        LV_LONDON_L  => 7
        LV_NYAM_H    => 7
        LV_NYAM_L    => 7
        LV_NYPM_H    => 6
        LV_NYPM_L    => 6
        LV_EQH       => 6
        LV_EQL       => 6
        LV_NY_H      => 7
        LV_NY_L      => 7
        => 5

levelIsHigh(int k) =>
    k == LV_PDH or k == LV_PWH or k == LV_ASIA_H or k == LV_LONDON_H or k == LV_NYAM_H or k == LV_NYPM_H or k == LV_EQH or k == LV_NY_H or k == LV_SESSION_H

levelIsSessionExtreme(int k) =>
    k >= LV_ASIA_H and k <= LV_NYPM_L

type Level
    int   kind
    float price   = na
    bool  active  = false
    bool  raided  = false
    int   cluster = 1

type LevelState
    array<Level> lv
    int   day        = na
    int   week       = na
    float todayHigh  = na
    float todayLow   = na
    int   todayBars  = 0
    float weekHigh   = na
    float weekLow    = na
    float asiaH      = na
    float asiaL      = na
    float londonH    = na
    float londonL    = na
    float nyamH      = na
    float nyamL      = na
    float nypmH      = na
    float nypmL      = na
    float nyH        = na
    float nyL        = na
    bool  inAsia     = false
    bool  inLondon   = false
    bool  inNyam     = false
    bool  inNypm     = false
    bool  inNy       = false
    // EQUAL clusters (seeded by 5m swing points, 50_structure)
    float eqHiRef    = na
    int   eqHiCount  = 0
    float eqLoRef    = na
    int   eqLoCount  = 0

newLevelState() =>
    array<Level> a = array.new<Level>()
    for k = 0 to LV_COUNT - 1
        a.push(Level.new(k))
    LevelState.new(a)

method register(LevelState this, int kind, float price) =>
    if not na(price) and price > 0
        Level x = this.lv.get(kind)
        x.price   := price
        x.active  := true
        x.raided  := false
        x.cluster := 1

hiOf(float a, float b) => na(a) ? b : math.max(a, b)
loOf(float a, float b) => na(a) ? b : math.min(a, b)

// LevelEngine.processCandle (1m)
method processCandle(LevelState this, int t, float h, float l) =>
    if not inHalt(t)
        int d = tradingDayKey(t)
        int w = weekKey(t)
        if na(this.day) or d != this.day
            if not na(this.day) and not na(this.todayHigh) and this.todayBars >= i_minBarsPerDay
                this.register(LV_PDH, this.todayHigh)
                this.register(LV_PDL, this.todayLow)
            this.day       := d
            this.todayHigh := h
            this.todayLow  := l
            this.todayBars := 0
            this.asiaH   := na
            this.asiaL   := na
            this.londonH := na
            this.londonL := na
            this.nyamH   := na
            this.nyamL   := na
            this.nypmH   := na
            this.nypmL   := na
            this.nyH     := na
            this.nyL     := na
        if na(this.week) or w != this.week
            if not na(this.week) and not na(this.weekHigh)
                this.register(LV_PWH, this.weekHigh)
                this.register(LV_PWL, this.weekLow)
            this.week     := w
            this.weekHigh := h
            this.weekLow  := l
        // session tracking (updateSessionTracking): register on window exit
        bool wasAsia = this.inAsia
        bool wasLon  = this.inLondon
        bool wasNy   = this.inNy
        bool wasNyam = this.inNyam
        bool wasNypm = this.inNypm
        this.inAsia   := inWinHHMM(t, i_asiaStart, i_asiaEnd)
        this.inLondon := inWinHHMM(t, i_londonStart, i_londonEnd)
        this.inNy     := inWinHHMM(t, i_nyStart, i_nyEnd)
        this.inNyam   := inWinHHMM(t, i_nyamStart, i_nyamEnd)
        this.inNypm   := inWinHHMM(t, i_nypmStart, i_nypmEnd)
        if not this.inNyam and wasNyam and not na(this.nyamH)
            this.register(LV_NYAM_H, this.nyamH)
            this.register(LV_NYAM_L, this.nyamL)
        if not this.inNypm and wasNypm and not na(this.nypmH)
            this.register(LV_NYPM_H, this.nypmH)
            this.register(LV_NYPM_L, this.nypmL)
        if this.inNyam
            this.nyamH := hiOf(this.nyamH, h)
            this.nyamL := loOf(this.nyamL, l)
        if this.inNypm
            this.nypmH := hiOf(this.nypmH, h)
            this.nypmL := loOf(this.nypmL, l)
        if not this.inAsia and wasAsia and not na(this.asiaH)
            this.register(LV_ASIA_H, this.asiaH)
            this.register(LV_ASIA_L, this.asiaL)
        if not this.inLondon and wasLon and not na(this.londonH)
            this.register(LV_LONDON_H, this.londonH)
            this.register(LV_LONDON_L, this.londonL)
        if not this.inNy and wasNy and not na(this.nyH)
            this.register(LV_NY_H, this.nyH)
            this.register(LV_NY_L, this.nyL)
        if this.inAsia
            this.asiaH := hiOf(this.asiaH, h)
            this.asiaL := loOf(this.asiaL, l)
        if this.inLondon
            this.londonH := hiOf(this.londonH, h)
            this.londonL := loOf(this.londonL, l)
        if this.inNy
            this.nyH := hiOf(this.nyH, h)
            this.nyL := loOf(this.nyL, l)
        // rearmRaidedLevels
        float dist = i_rearmLvlTicks * TICK
        if dist > 0
            for x in this.lv
                if x.active and x.raided
                    bool left = levelIsHigh(x.kind) ? h < x.price - dist : l > x.price + dist
                    if left
                        x.raided := false
        this.todayBars := this.todayBars + 1
        this.todayHigh := hiOf(this.todayHigh, h)
        this.todayLow  := loOf(this.todayLow, l)
        this.weekHigh  := hiOf(this.weekHigh, h)
        this.weekLow   := loOf(this.weekLow, l)

// EQUAL_HIGH / EQUAL_LOW (PORT_APPROX of EqualLevelDetector): a new 5m swing point within
// i_eqTolTicks of the running cluster reference joins it; >= 2 members registers the level
// at the cluster extreme, cluster size feeds the +1 (>= 3) raid-score term.
method onSwingPoint(LevelState this, bool isHigh, float price) =>
    float tol = i_eqTolTicks * TICK
    if isHigh
        if not na(this.eqHiRef) and math.abs(price - this.eqHiRef) <= tol
            this.eqHiCount := this.eqHiCount + 1
            this.eqHiRef := math.max(this.eqHiRef, price)
            this.register(LV_EQH, this.eqHiRef)
            Level qh = this.lv.get(LV_EQH)
            qh.cluster := this.eqHiCount
        else
            this.eqHiRef   := price
            this.eqHiCount := 1
    else
        if not na(this.eqLoRef) and math.abs(price - this.eqLoRef) <= tol
            this.eqLoCount := this.eqLoCount + 1
            this.eqLoRef := math.min(this.eqLoRef, price)
            this.register(LV_EQL, this.eqLoRef)
            Level ql = this.lv.get(LV_EQL)
            ql.cluster := this.eqLoCount
        else
            this.eqLoRef   := price
            this.eqLoCount := 1
// ==== file: 40_raid.pine ====
// =============================================================================
// 40_raid — raid detection + V5 quality score 1..10 (tick tolerances only).
// Java: chartstate/RaidDetector.java:153 (checkLevelForRaid, checkForRejection),
//       chartstate/RaidDetector.java:476 (scoreSweep), chartstate/RaidQualityScorer.java:110,
//       strategy/LiquidityDetector.java (swing sweep), StdvOteRunnerStrategy.resolveSweep (:2062).
// All on the 1m feed (Java runs them on 1m candles).
// =============================================================================

// ---- rolling 1m feed buffer (LiquidityDetector primaryCandles + candleSeries + OteSetupDriver feedBars)
const int FEED_CAP = 32

type Feed1
    array<int>   t
    array<float> o
    array<float> h
    array<float> l
    array<float> c
    int count = 0       // total 1m candles processed (LiquidityDetector.totalCandleCount)

newFeed1() =>
    Feed1.new(t = array.new<int>(), o = array.new<float>(), h = array.new<float>(), l = array.new<float>(), c = array.new<float>())

method add(Feed1 this, int t, float o, float h, float l, float c) =>
    this.t.push(t)
    this.o.push(o)
    this.h.push(h)
    this.l.push(l)
    this.c.push(c)
    this.count := this.count + 1
    if this.t.size() > FEED_CAP
        this.t.shift()
        this.o.shift()
        this.h.shift()
        this.l.shift()
        this.c.shift()

// ---- scoring context (RaidDetector.RaidDetectionContext built each 1m bar in the runner :896-912)
type ScoreCtx
    int   htfDir    = 0      // +1 bullish / -1 bearish / 0 none (setup bias, else last bias)
    bool  smt       = false  // CorrelationTracker SMT this bar
    bool  dispEntry = false  // DisplacementDetector.hasLayer3EntryTrigger(5, dir)
    float eq        = na     // dealing-range equilibrium when decisive
    bool  kz        = false  // legacy NY killzone
    bool  sb        = false  // Silver Bullet window

// RaidQualityScorer.calculateScore (raid.weights = V5)
// PORT_APPROX (PORT_MAP L5): "HTF strong trend" reads HtfTrendAnalyzer (DROP) -> alignment is
// always the WEAK +2 term; multi-touch term (KnownLevel touch counts) is not tracked -> 0;
// zone-confluence and target-alignment terms are 0 in Java's runner context as well.
scoreRaid(bool lowSweep, int kind, int cluster, float level, float o, float h, float l, float c, ScoreCtx ctx) =>
    int s = 1
    bool expectBull = lowSweep
    bool aligned = ctx.htfDir != 0 and ((ctx.htfDir > 0) == expectBull)
    bool opposes = ctx.htfDir != 0 and ((ctx.htfDir > 0) != expectBull)
    if aligned
        s += 2
    if ctx.kz
        s += 2
    if ctx.sb
        s += 1
    if kind == LV_PDH or kind == LV_PDL or kind == LV_PWH or kind == LV_PWL
        s += 2
    else if levelIsSessionExtreme(kind)
        s += 2
    else if (kind == LV_EQH or kind == LV_EQL) and cluster >= 3
        s += 1
    // rejection quality (max +2)
    bool highSweep = not lowSweep
    bool closedBack = highSweep ? c <= level : c >= level
    float rng = h - l
    float wick = rng > 0 ? (highSweep ? (h - math.max(o, c)) / rng : (math.min(o, c) - l) / rng) : 0.0
    float rejTicks = math.abs(c - level) / TICK
    if wick >= 0.50 or (closedBack and rejTicks >= i_raidStrongTicks)
        s += 2
    else if wick >= 0.30 or closedBack
        s += 1
    // premium / discount vs the dealing-range eq (+1)
    if not na(ctx.eq)
        if highSweep and level > ctx.eq
            s += 1
        else if lowSweep and level < ctx.eq
            s += 1
    if ctx.smt
        s += 2
    if ctx.dispEntry
        s += 2
    if opposes
        s -= 4
    math.max(1, math.min(10, s))

// RaidDetector.checkForRejection
hasRejection(bool lowSweep, float level, float o, float h, float l, float c) =>
    float rng = h - l
    bool ok = false
    if rng > 0
        if not lowSweep
            ok := c <= level or (h - math.max(o, c)) / rng >= 0.4
        else
            ok := c >= level or (math.min(o, c) - l) / rng >= 0.4
    ok

// ---- registered level raids (RaidDetector.activeRaids, newest per direction)
type Raid
    bool  valid    = false
    bool  lowSweep = false
    float level    = na
    int   kind     = na
    int   score    = 0
    int   bar1m    = na
    int   ts       = na
    int   id       = na

type RaidState
    Raid  lastLow
    Raid  lastHigh
    int   nextId   = 1
    // last swing sweep (LiquidityDetector.lastSweep — ONE slot for both directions, like Java)
    bool  swValid  = false
    bool  swLow    = false
    float swLevel  = na
    int   swTs     = na
    int   swCount  = na
    float swO      = na
    float swH      = na
    float swL      = na
    float swC      = na
    float swPrior  = na
    // debug: raids registered on the current chart bar
    array<int>   dbgT
    array<float> dbgP
    array<int>   dbgS
    array<bool>  dbgLow

newRaidState() =>
    RaidState.new(lastLow = Raid.new(), lastHigh = Raid.new(), dbgT = array.new<int>(), dbgP = array.new<float>(), dbgS = array.new<int>(), dbgLow = array.new<bool>())

// RaidDetector.processCandle over every unraided known level (1m)
method processCandle(RaidState this, LevelState lvs, Feed1 f, int t, float o, float h, float l, float c, ScoreCtx ctx) =>
    float tol = i_raidTolTicks * TICK
    float pen = i_raidPenTicks * TICK
    for x in lvs.lv
        if x.active and not x.raided
            bool isHi = levelIsHigh(x.kind)
            float p = x.price
            bool swept = isHi ? (h > p + pen and l <= p + tol) : (l < p - pen and h >= p - tol)
            if swept and hasRejection(not isHi, p, o, h, l, c)
                int sc = scoreRaid(not isHi, x.kind, x.cluster, p, o, h, l, c, ctx)
                if sc >= i_raidThreshold
                    x.raided := true
                    Raid r = Raid.new(true, not isHi, p, x.kind, sc, f.count, t, this.nextId)
                    this.nextId := this.nextId + 1
                    Raid prev = isHi ? this.lastHigh : this.lastLow
                    // newest wins; same bar -> best score (BEST_RAID_ORDER)
                    if not prev.valid or prev.bar1m != f.count or sc > prev.score
                        if isHi
                            this.lastHigh := r
                        else
                            this.lastLow := r
                    this.dbgT.push(t)
                    this.dbgP.push(p)
                    this.dbgS.push(sc)
                    this.dbgLow.push(not isHi)

// LiquidityDetector.detectLiquiditySweeps on the newest 1m candle (already pushed into f)
method detectSwingSweep(RaidState this, Feed1 f) =>
    int n = f.t.size()
    if n >= 5
        int fr = math.max(0, n - i_swingSweepLen)
        float rh = f.h.get(fr)
        float rl = f.l.get(fr)
        for k = fr to n - 1
            rh := math.max(rh, f.h.get(k))
            rl := math.min(rl, f.l.get(k))
        float lh = f.h.get(n - 1)
        float ll = f.l.get(n - 1)
        float lc = f.c.get(n - 1)
        bool bull = ll <= rl and lc > rl
        bool bear = not bull and lh >= rh and lc < rh
        if bull or bear
            this.swValid := true
            this.swLow   := bull
            this.swLevel := bull ? rl : rh
            this.swTs    := f.t.get(n - 1)
            this.swCount := f.count
            this.swO     := f.o.get(n - 1)
            this.swH     := lh
            this.swL     := ll
            this.swC     := lc
            // prior extreme = up to 9 bars before the sweep candle (StdvOteRunnerStrategy.currentRaidScore)
            float pr = na
            if n >= 2
                for k = math.max(0, n - 10) to n - 2
                    pr := bull ? loOf(pr, f.l.get(k)) : hiOf(pr, f.h.get(k))
            this.swPrior := pr

// RaidDetector.scoreSweep: the sweep candle vs every known level it took (most significant wins,
// tie -> higher price), else the prior swing extreme scored as SESSION_HIGH/LOW. Returns
// [ok, score, kind, level]; ok = false -> NOT_A_SWEEP; prior na -> starved (floor - 1).
method scoreSwingSweep(RaidState this, LevelState lvs, ScoreCtx ctx) =>
    bool lowSweep = this.swLow
    float tol = i_raidTolTicks * TICK
    float pen = i_raidPenTicks * TICK
    int bestKind = na
    float bestP = na
    int bestCl = 1
    for x in lvs.lv
        if x.active and levelIsHigh(x.kind) != lowSweep
            float p = x.price
            bool swept = lowSweep ? (this.swL < p - pen and this.swH >= p - tol) : (this.swH > p + pen and this.swL <= p + tol)
            if swept and hasRejection(lowSweep, p, this.swO, this.swH, this.swL, this.swC)
                if na(bestKind) or levelSignificance(x.kind) > levelSignificance(bestKind) or (levelSignificance(x.kind) == levelSignificance(bestKind) and p > bestP)
                    bestKind := x.kind
                    bestP := p
                    bestCl := x.cluster
    bool ok = true
    int sc = 0
    if na(this.swPrior)
        sc := i_minRaidScore - 1    // raid.starvedScore = floor - 1 (never passes M4)
        bestKind := lowSweep ? LV_SESSION_L : LV_SESSION_H
        bestP := this.swLevel
    else
        if na(bestKind)
            bool sweptPrior = lowSweep ? this.swL < this.swPrior : this.swH > this.swPrior
            if sweptPrior and hasRejection(lowSweep, this.swPrior, this.swO, this.swH, this.swL, this.swC)
                bestKind := lowSweep ? LV_SESSION_L : LV_SESSION_H
                bestP := this.swPrior
            else
                ok := false
        if ok
            sc := scoreRaid(lowSweep, bestKind, bestCl, bestP, this.swO, this.swH, this.swL, this.swC, ctx)
    [ok, sc, bestKind, bestP]

// StdvOteRunnerStrategy.resolveSweep(wantLow, levelOnly): best of the recent level raid and the
// swing sweep (swing wins only with a strictly higher score). Returns
// [found, sweptLevel, ts, score, kind, raidId, swingTs].
method resolveSweep(RaidState this, LevelState lvs, Feed1 f, ScoreCtx ctx, bool wantLow, bool levelOnly, int consumedRaidId, int consumedSweepTs) =>
    bool found = false
    float lvl = na
    int ts = na
    int sc = 0
    int kind = na
    int rid = na
    int swTs = na
    Raid r = wantLow ? this.lastLow : this.lastHigh
    if r.valid and f.count - r.bar1m <= i_sweepRecency and (na(consumedRaidId) or r.id != consumedRaidId)
        found := true
        lvl := r.level
        ts := r.ts
        sc := r.score
        kind := r.kind
        rid := r.id
    if not levelOnly and this.swValid and f.count - this.swCount <= i_sweepRecency and this.swLow == wantLow and (na(consumedSweepTs) or this.swTs != consumedSweepTs)
        [ok, ssc, skind, sp] = this.scoreSwingSweep(lvs, ctx)
        if ok and (not found or ssc > sc)
            found := true
            lvl := this.swLevel
            ts := this.swTs
            sc := ssc
            kind := skind
            rid := na
            swTs := this.swTs
    [found, lvl, ts, sc, kind, rid, swTs]
// ==== file: 50_structure.pine ====
// =============================================================================
// 50_structure — the 5m "anatomy" series: bar buffer (PdArrayLocator bars), swings,
// MSS (close beyond the most recent opposite 2-bar fractal), displacement (ATR multiple).
// Java: strategy/stdvote/PdArrayLocator.java (MAX_BARS 200), strategy/MarketStructureShiftDetector.java
//       (forStdvOte: lookback 50, swing 2, closeBeyondRecentSwing), strategy/DisplacementDetector.java:216.
// The anatomy bar is fed when the FIRST 1m candle of the next 5m bucket arrives
// (BarAggregationManager completes a period on the next period's first candle).
// =============================================================================
const int BUF5_CAP     = 200
const int MSS_LOOKBACK = 50
const int MSS_SWING    = 2

type Buf5
    array<int>   t
    array<float> o
    array<float> h
    array<float> l
    array<float> c
    int firstIdx = 0
    int lastIdx  = -1

newBuf5() =>
    Buf5.new(t = array.new<int>(), o = array.new<float>(), h = array.new<float>(), l = array.new<float>(), c = array.new<float>())

method add(Buf5 this, int t, float o, float h, float l, float c) =>
    this.t.push(t)
    this.o.push(o)
    this.h.push(h)
    this.l.push(l)
    this.c.push(c)
    this.lastIdx := this.lastIdx + 1
    if this.t.size() > BUF5_CAP
        this.t.shift()
        this.o.shift()
        this.h.shift()
        this.l.shift()
        this.c.shift()
        this.firstIdx := this.firstIdx + 1
    this.lastIdx

method has(Buf5 this, int idx) =>
    not na(idx) and idx >= this.firstIdx and idx <= this.lastIdx

method bT(Buf5 this, int idx) => this.t.get(idx - this.firstIdx)
method bO(Buf5 this, int idx) => this.o.get(idx - this.firstIdx)
method bH(Buf5 this, int idx) => this.h.get(idx - this.firstIdx)
method bL(Buf5 this, int idx) => this.l.get(idx - this.firstIdx)
method bC(Buf5 this, int idx) => this.c.get(idx - this.firstIdx)

// PdArrayLocator.indexOf(ts): newest bar with this open time, else -1
method indexOf(Buf5 this, int ts) =>
    int found = -1
    if not na(ts) and this.lastIdx >= this.firstIdx
        for i = this.lastIdx to this.firstIdx
            if this.bT(i) == ts
                found := i
                break
    found

// PdArrayLocator.lastBarAt(price, wantHigh, toIdx): newest bar <= toIdx whose high/low == price (+- tick/2)
method lastBarAt(Buf5 this, float price, bool wantHigh, int toIdx) =>
    int found = -1
    float tol = math.max(1e-9, TICK / 2.0)
    if not na(price) and this.lastIdx >= this.firstIdx
        for i = this.lastIdx to this.firstIdx
            if i <= toIdx
                float v = wantHigh ? this.bH(i) : this.bL(i)
                if math.abs(v - price) <= tol
                    found := i
                    break
    found

// ---- displacement events (DisplacementDetector history)
type DispEv
    int   ts
    int   idx
    bool  bullish
    float rangeOverAtr
    float body
    bool  createdFvg
    bool  brokeMss

// ---- MSS events (OteSetupDriver.mssEvents)
type MssEv
    bool  bullish
    float level
    int   ts
    int   idx

type Structure
    array<DispEv> disp
    array<MssEv>  mss
    // MSS detector swing state (latest swing high / low inside the 50-bar window)
    float swHiP     = na
    int   swHiIdx   = na
    int   swHiTs    = na
    bool  swHiBroke = false
    float swLoP     = na
    int   swLoIdx   = na
    int   swLoTs    = na
    bool  swLoBroke = false
    // DisplacementDetector 3-bar fractal (checkForMss reference)
    float dSwingHi  = na
    float dSwingLo  = na
    float lastAtr   = na
    // debug: last MSS
    float dbgMssLevel = na
    int   dbgMssTs    = na
    bool  dbgMssBull  = false

newStructure() =>
    Structure.new(disp = array.new<DispEv>(), mss = array.new<MssEv>())

// DisplacementDetector.detectDisplacement on the newest anatomy bar (b.lastIdx)
method detectDisplacement(Structure this, Buf5 b) =>
    int idx = b.lastIdx
    int winStart = math.max(b.firstIdx, idx - 19)     // detector keeps 20 candles
    int fr = math.max(winStart + 1, idx - i_dispAtrLen)
    float sum = 0.0
    int cnt = 0
    if idx - 1 >= fr
        for i = fr to idx - 1
            float pc = b.bC(i - 1)
            sum += math.max(b.bH(i) - b.bL(i), math.max(math.abs(b.bH(i) - pc), math.abs(b.bL(i) - pc)))
            cnt += 1
    float avgRange = cnt > 0 ? sum / cnt : 10.0
    float o = b.bO(idx)
    float h = b.bH(idx)
    float l = b.bL(idx)
    float c = b.bC(idx)
    float rng = h - l
    float body = math.abs(c - o)
    float bodyRatio = rng > 0 ? body / rng : 0.0
    float minMove = avgRange * i_dispAtrMult
    this.lastAtr := avgRange
    if bodyRatio >= i_dispBodyPct and rng >= minMove
        bool bull = c > o
        int consec = 1
        if idx - 1 >= winStart
            for i = idx - 1 to math.max(winStart, idx - 2)
                float pr = b.bH(i) - b.bL(i)
                float pbr = pr > 0 ? math.abs(b.bC(i) - b.bO(i)) / pr : 0.0
                bool pBull = b.bC(i) > b.bO(i)
                if pBull == bull and pbr >= i_dispBodyPct * 0.8
                    consec += 1
                else
                    break
        float total = consec >= 2 ? (bull ? c - b.bO(idx - consec + 1) : b.bO(idx - consec + 1) - c) : body
        if consec < 2 or total >= minMove
            // PORT_APPROX: checkForFvgCreation / checkForMss (only feed the +2 "displacement entry" raid term)
            bool fvg = b.has(idx - 2) and (bull ? l > b.bH(idx - 2) : h < b.bL(idx - 2))
            bool brk = bull ? (not na(this.dSwingHi) and c > this.dSwingHi) : (not na(this.dSwingLo) and c < this.dSwingLo)
            this.disp.push(DispEv.new(b.bT(idx), idx, bull, avgRange > 0 ? rng / avgRange : na, bodyRatio, fvg, brk))
            if this.disp.size() > 100
                this.disp.shift()
    // fractal update (mid = idx - 1)
    if b.has(idx - 2)
        if b.bH(idx - 1) > b.bH(idx - 2) and b.bH(idx - 1) > h
            this.dSwingHi := b.bH(idx - 1)
        if b.bL(idx - 1) < b.bL(idx - 2) and b.bL(idx - 1) < l
            this.dSwingLo := b.bL(idx - 1)

// MarketStructureShiftDetector.update (forStdvOte) on the newest anatomy bar.
// Returns [swingHighFound, swingHighPrice, swingLowFound, swingLowPrice] for the EQUAL-level clusters.
method updateMss(Structure this, Buf5 b) =>
    int idx = b.lastIdx
    int winStart = math.max(b.firstIdx, idx - (MSS_LOOKBACK - 1))
    bool newHi = false
    bool newLo = false
    float hiP = na
    float loP = na
    // swings that aged out of the 50-bar window are dropped (adjustSwingIndices)
    if not na(this.swHiIdx) and this.swHiIdx < winStart
        this.swHiP := na
        this.swHiIdx := na
        this.swHiTs := na
    if not na(this.swLoIdx) and this.swLoIdx < winStart
        this.swLoP := na
        this.swLoIdx := na
        this.swLoTs := na
    int piv = idx - MSS_SWING
    if piv - MSS_SWING >= winStart
        float ph = b.bH(piv)
        float pl = b.bL(piv)
        bool isHi = true
        bool isLo = true
        for i = piv - MSS_SWING to piv + MSS_SWING
            if i != piv
                if b.bH(i) > ph
                    isHi := false
                if b.bL(i) < pl
                    isLo := false
        if isHi and (na(this.swHiIdx) or this.swHiIdx != piv)
            this.swHiP := ph
            this.swHiIdx := piv
            this.swHiTs := b.bT(piv)
            this.swHiBroke := false
            newHi := true
            hiP := ph
        if isLo and (na(this.swLoIdx) or this.swLoIdx != piv)
            this.swLoP := pl
            this.swLoIdx := piv
            this.swLoTs := b.bT(piv)
            this.swLoBroke := false
            newLo := true
            loP := pl
    float c = b.bC(idx)
    if not na(this.swHiIdx) and idx - this.swHiIdx >= 2 and not this.swHiBroke and c > this.swHiP
        this.swHiBroke := true
        this.mss.push(MssEv.new(true, this.swHiP, b.bT(idx), idx))
        this.dbgMssLevel := this.swHiP
        this.dbgMssTs := b.bT(idx)
        this.dbgMssBull := true
    else if not na(this.swLoIdx) and idx - this.swLoIdx >= 2 and not this.swLoBroke and c < this.swLoP
        this.swLoBroke := true
        this.mss.push(MssEv.new(false, this.swLoP, b.bT(idx), idx))
        this.dbgMssLevel := this.swLoP
        this.dbgMssTs := b.bT(idx)
        this.dbgMssBull := false
    if this.mss.size() > 200
        this.mss.shift()
    [newHi, hiP, newLo, loP]

// DisplacementDetector.findRecent(recentBars, bullish, notBefore): newest wanted-direction
// displacement within the last n anatomy bars, at/after notBefore. Returns the event or na.
method findRecentDisp(Structure this, Buf5 b, int n, bool bullish, int notBefore) =>
    DispEv out = na
    int sz = this.disp.size()
    if sz > 0
        for k = sz - 1 to 0
            DispEv e = this.disp.get(k)
            if b.lastIdx - e.idx > n
                break
            if e.bullish == bullish and (na(notBefore) or e.ts >= notBefore)
                out := e
                break
    out

method anyRecentDisp(Structure this, Buf5 b, int n, int notBefore) =>
    bool any = false
    int sz = this.disp.size()
    if sz > 0
        for k = sz - 1 to 0
            DispEv e = this.disp.get(k)
            if b.lastIdx - e.idx > n
                break
            if na(notBefore) or e.ts >= notBefore
                any := true
                break
    any

// DisplacementDetector.hasLayer3EntryTrigger(5, bullish): last displacement within 5 bars,
// same direction, created an FVG and broke structure (+2 raid-score term)
method dispEntryTrigger(Structure this, Buf5 b, bool bullish) =>
    bool ok = false
    int sz = this.disp.size()
    if sz > 0
        DispEv e = this.disp.get(sz - 1)
        ok := e.bullish == bullish and b.lastIdx - e.idx <= 5 and e.createdFvg and e.brokeMss
    ok
// ==== file: 60_fvg_ote.pine ====
// =============================================================================
// 60_fvg_ote — PD arrays (FVG / IFVG / BREAKER / OB / WICK) on the 5m anatomy buffer,
// OTE zone (fibs from the terminus, tick-rounded), entry level, target ladder, reactions.
// Java: strategy/stdvote/PdArrayLocator.java, strategy/stdvote/OteEntryCalculator.java,
//       strategy/stdvote/OteSetupDriver.java (impulseCandidates, ictOrderBlock, reaction, impulseReaction).
// =============================================================================
const int PD_SCAN_BARS = 60

type PdArr
    string kind
    bool   bullish
    float  bottom
    float  top
    int    at

method farEdge(PdArr this) =>
    this.bullish ? this.bottom : this.top

// OteZone (OteEntryCalculator.buildZone)
type Zone
    bool  valid   = false
    bool  bullish = false
    float legLow  = na
    float legHigh = na
    float eq50    = na
    float f62     = na
    float f705    = na
    float f79     = na
    float one00   = na

method bandLo(Zone this) => math.min(this.f62, this.f79)
method bandHi(Zone this) => math.max(this.f62, this.f79)
method contains(Zone this, float p) => not na(p) and p >= this.bandLo() and p <= this.bandHi()

buildZone(float lo, float hi, bool bullish) =>
    Zone z = Zone.new()
    if not na(lo) and not na(hi) and hi > lo
        float rng = hi - lo
        float eq50 = bullish ? hi - 0.5 * rng : lo + 0.5 * rng
        float f62  = bullish ? hi - i_fib62 * rng : lo + i_fib62 * rng
        float f705 = bullish ? hi - i_fib705 * rng : lo + i_fib705 * rng
        float f79  = bullish ? hi - i_fib79 * rng : lo + i_fib79 * rng
        float one  = bullish ? lo : hi
        f62  := roundTick(f62)
        f705 := roundTick(f705)
        f79  := roundTick(f79)
        if f62 != f705 and f705 != f79
            z := Zone.new(true, bullish, roundTick(lo), roundTick(hi), roundTick(eq50), f62, f705, f79, roundTick(one))
    z

// OteEntryCalculator.fibLevel / targetLadder: [T1 = 0.5, T2 = 0.382, T3 = 0.0] of the leg
method fibLevel(Zone this, float r) =>
    float rng = this.legHigh - this.legLow
    roundTick(this.bullish ? this.legHigh - r * rng : this.legLow + r * rng)

rewardToRisk(float entry, float stop, float target) =>
    float risk = math.abs(entry - stop)
    risk <= 0 ? 0.0 : math.abs(target - entry) / risk

// PdArrayLocator.gapAt(m): 3-bar gap with c2 = m
gapAt(Buf5 b, int m, bool bullish) =>
    PdArr g = na
    if b.has(m - 1) and b.has(m) and b.has(m + 1)
        float h1 = b.bH(m - 1)
        float l1 = b.bL(m - 1)
        float h3 = b.bH(m + 1)
        float l3 = b.bL(m + 1)
        if bullish and h1 < l3
            g := PdArr.new("FVG", true, h1, l3, b.bT(m))
        else if not bullish and l1 > h3
            g := PdArr.new("FVG", false, h3, l1, b.bT(m))
    g

// linkedFvg(dispIdx): first gap whose middle bar is the displacement bar .. +linkBars, else the gap ending on it
linkedFvg(Buf5 b, int dispIdx, bool bullish) =>
    PdArr g = na
    if dispIdx >= 0
        for m = dispIdx to dispIdx + i_fvgLinkBars
            PdArr x = gapAt(b, m, bullish)
            if not na(x)
                g := x
                break
        if na(g)
            g := gapAt(b, dispIdx - 1, bullish)
    g

linkWindowClosed(Buf5 b, int dispIdx) =>
    b.lastIdx >= dispIdx + i_fvgLinkBars + 1

// PdArrayLocator.orderBlock(dispIdx): newest opposite-close bar among the 5 before the
// displacement whose range is closed through within the link window
orderBlockAt(Buf5 b, int dispIdx, bool bullish) =>
    PdArr ob = na
    bool done = false
    for j = dispIdx - 1 to dispIdx - 5
        if done or not b.has(j)
            break
        bool opp = bullish ? b.bC(j) < b.bO(j) : b.bC(j) > b.bO(j)
        if opp
            done := true
            int kEnd = math.min(b.lastIdx, dispIdx + i_fvgLinkBars)
            if kEnd >= dispIdx
                for k = dispIdx to kEnd
                    if b.has(k)
                        bool broke = bullish ? b.bC(k) > b.bH(j) : b.bC(k) < b.bL(j)
                        if broke
                            ob := PdArr.new("OB", bullish, b.bL(j), b.bH(j), b.bT(j))
                            break
    ob

// largest same-direction gap in [fromIdx, toIdx] (gapInWindow)
gapInWindow(Buf5 b, int fromIdx, int toIdx, bool bullish) =>
    PdArr best = na
    if toIdx >= fromIdx
        for m = fromIdx to toIdx
            PdArr g = gapAt(b, m, bullish)
            if not na(g) and (na(best) or g.top - g.bottom > best.top - best.bottom)
                best := g
    best

filledAfter(Buf5 b, PdArr g, int fromIdx) =>
    bool hit = false
    if b.lastIdx >= fromIdx + 1
        for k = fromIdx + 1 to b.lastIdx
            if b.has(k) and (g.bullish ? b.bL(k) < g.bottom : b.bH(k) > g.top)
                hit := true
                break
    hit

closedThroughAfter(Buf5 b, float bottom, float top, int fromIdx, bool dirBullish) =>
    bool hit = false
    if b.lastIdx >= fromIdx
        for k = fromIdx to b.lastIdx
            if b.has(k) and (dirBullish ? b.bC(k) > top : b.bC(k) < bottom)
                hit := true
                break
    hit

// PdArrayLocator.candidates(bullish): unfilled FVGs, IFVGs, BREAKERs over the last 60 bars
pdCandidates(Buf5 b, bool bullish) =>
    array<PdArr> out = array.new<PdArr>()
    if b.t.size() >= 3
        int first = math.max(b.firstIdx + 1, b.lastIdx - PD_SCAN_BARS)
        if b.lastIdx - 1 >= first
            for m = first to b.lastIdx - 1
                PdArr g = gapAt(b, m, bullish)
                if not na(g) and not filledAfter(b, g, m + 1)
                    out.push(g)
                PdArr gi = gapAt(b, m, not bullish)
                if not na(gi) and closedThroughAfter(b, gi.bottom, gi.top, m + 1, bullish)
                    out.push(PdArr.new("IFVG", bullish, gi.bottom, gi.top, gi.at))
                if b.has(m + 1)
                    bool oppOb = bullish ? (b.bC(m) > b.bO(m) and b.bC(m + 1) < b.bL(m)) : (b.bC(m) < b.bO(m) and b.bC(m + 1) > b.bH(m))
                    if oppOb and closedThroughAfter(b, b.bL(m), b.bH(m), m + 2, bullish)
                        out.push(PdArr.new("BREAKER", bullish, b.bL(m), b.bH(m), b.bT(m)))
    out

// sweepOrderBlock: the 5m bar containing the sweep, opposite close, took the level
sweepOrderBlock(Buf5 b, int idx, bool bullish, float level) =>
    PdArr ob = na
    if b.has(idx)
        bool opp = bullish ? b.bC(idx) < b.bO(idx) : b.bC(idx) > b.bO(idx)
        bool took = bullish ? b.bL(idx) <= level : b.bH(idx) >= level
        if opp and took
            ob := PdArr.new("OB", bullish, b.bL(idx), b.bH(idx), b.bT(idx))
    ob

pdOverlaps(PdArr p, Zone z) =>
    p.bottom <= z.bandHi() and p.top >= z.bandLo()

// PdArrayLocator.entryLevel: OB midpoint, else the near edge; clamped into the band
pdEntryLevel(PdArr p, Zone z) =>
    float raw = p.kind == "OB" ? (p.bottom + p.top) / 2.0 : (p.bullish ? p.top : p.bottom)
    math.max(z.bandLo(), math.min(z.bandHi(), raw))

pdRank(PdArr p) =>
    p.kind == "OB" ? 0 : p.kind == "FVG" ? 1 : p.kind == "IFVG" ? 2 : 3

// bestInBand: overlaps the band, entry nearest 0.705, tie OB > FVG > IFVG > BREAKER (WICK ranks last)
bestInBand(array<PdArr> cands, Zone z) =>
    PdArr best = na
    float bestD = na
    for p in cands
        if not na(p) and p.bullish == z.bullish and pdOverlaps(p, z)
            float d = math.abs(pdEntryLevel(p, z) - z.f705)
            if na(best) or d < bestD - 1e-9 or (math.abs(d - bestD) <= 1e-9 and pdRank(p) < pdRank(best))
                best := p
                bestD := d
    best

// OteSetupDriver.reaction (POST_SWEEP alarm)
reactionPostSweep(Zone z, float o, float h, float l, float c) =>
    bool ok = false
    if z.bullish
        if l <= z.bandHi()
            ok := l <= z.f705 or c > z.bandHi() or c > o
    else
        if h >= z.bandLo()
            ok := h >= z.f705 or c < z.bandLo() or c < o
    ok

// OteSetupDriver.impulseReaction (IMPULSE_LEG alarm): touches the band AND closes back beyond the
// swept level in the trade direction (stdvOte.reactionWickTicks is dead — PORT_MAP §10.3)
reactionImpulse(Zone z, float o, float h, float l, float c, float swept) =>
    bool ok = false
    if z.bullish
        if l <= z.bandHi()
            ok := c > swept and c > o
    else
        if h >= z.bandLo()
            ok := c < swept and c < o
    ok

closedBeyondExtreme(Zone z, float c) =>
    z.bullish ? c < z.one00 : c > z.one00

tradedIntoBand(Zone z, float h, float l) =>
    z.bullish ? l <= z.bandHi() : h >= z.bandLo()
// ==== file: 70_bias_smt.pine ====
// =============================================================================
// 70_bias_smt — dealing range (THE bias once decisive), SMT vs MES, the STDV-OTE setup
// state machine (IDLE -> BIAS_SET -> SWEEP_DONE -> DISPLACED -> MSS_CONFIRMED -> OTE_ARMED
// -> alarm -> emit), and the ENGINE loop that replays every 1m intrabar of the confirmed
// 5m chart bar in Java's per-candle order (StdvOteRunnerStrategy.onCandle :800-1200).
// Java: strategy/stdvote/DealingRangeTracker.java, strategy/CorrelationTracker.java:121,
//       strategy/stdvote/StdvOteStrategy.java (recordHtfBias :487, recordSweep :593, tryEmit :743),
//       strategy/stdvote/OteSetupDriver.java, strategy/stdvote/StdvOteRunnerStrategy.java.
// Named series for Agent 03 are at the END of this file ("EXPORTS").
// =============================================================================

// ---------------------------------------------------------------- dealing range
type DLeg
    float hi       = na
    float lo       = na
    int   hiSeq    = 0
    int   loSeq    = 0
    int   seq      = 0
    int   dir      = 0
    float pullback = na

// DealingRangeTracker.Leg.onBar
method onBar(DLeg this, float h, float l, float c, float minLeg, float frac) =>
    this.seq := this.seq + 1
    if this.dir == 0
        if h > this.hi
            this.hi := h
            this.hiSeq := this.seq
        if l < this.lo
            this.lo := l
            this.loSeq := this.seq
        if this.hi - this.lo >= minLeg and this.hiSeq != this.loSeq
            this.dir := this.hiSeq > this.loSeq ? 1 : -1
            this.pullback := na
    else if this.dir < 0
        if c > this.hi
            this.dir := 1
            this.hi := h
            this.pullback := na
        else if l < this.lo
            if not na(this.pullback) and this.pullback - this.lo >= frac * (this.hi - this.lo)
                this.hi := this.pullback
            this.lo := l
            this.pullback := na
        else
            if h > this.hi
                this.hi := h
            this.pullback := na(this.pullback) ? h : math.max(this.pullback, h)
    else
        if c < this.lo
            this.dir := -1
            this.lo := l
            this.pullback := na
        else if h > this.hi
            if not na(this.pullback) and this.hi - this.pullback >= frac * (this.hi - this.lo)
                this.lo := this.pullback
            this.hi := h
            this.pullback := na
        else
            if l < this.lo
                this.lo := l
            this.pullback := na(this.pullback) ? l : math.min(this.pullback, l)

type DRange
    int   tradingDay = na
    float hi         = na
    float lo         = na
    int   hiSeq      = 0
    int   loSeq      = 0
    int   seq        = 0
    int   dir        = 0
    int   carry      = 0
    float pullback   = na
    float carryHi    = na
    float carryLo    = na
    DLeg  rth
    bool  hasRth     = false
    bool  hasCarried = false
    float cHi        = na
    float cLo        = na
    int   cDir       = 0
    DLeg  sessionLeg

method rthGoverns(DRange this) =>
    this.hasRth and (i_rangeWindow == "RTH_FIRST" or (i_rangeWindow == "AUTO" and this.rth.dir != 0))

method sessionDayDirection(DRange this) =>
    int d = this.dir != 0 ? this.dir : this.carry
    this.hasCarried ? this.cDir : d

// DealingRangeTracker.snapshot -> [direction (+1/-1/0), high, low, equilibrium, decisive]
method snapshot(DRange this) =>
    int d = 0
    float sh = na
    float sl = na
    bool dec = false
    if not na(this.hi)
        bool rthDir = this.rthGoverns() and this.rth.dir != 0
        if this.hasCarried and not rthDir
            d := this.cDir
            sh := this.cHi
            sl := this.cLo
            dec := true
        else if this.rthGoverns()
            d := this.rth.dir != 0 ? this.rth.dir : this.sessionDayDirection()
            sh := this.rth.hi
            sl := this.rth.lo
            dec := this.rth.dir != 0
        else
            d := this.sessionDayDirection()
            bool useCarry = this.dir == 0 and this.carry != 0 and not na(this.carryHi)
            sh := useCarry ? this.carryHi : this.hi
            sl := useCarry ? this.carryLo : this.lo
            dec := d != 0
    float eq = na(sh) or na(sl) ? na : sl + (sh - sl) * 0.5
    [d, sh, sl, eq, dec]

method onRthCandle(DRange this, int t, float h, float l, float c) =>
    if i_rangeWindow != "SESSION_DAY"
        int mm = etMin(t)
        if mm >= 9 * 60 + 30 and mm < 17 * 60
            if not this.hasRth
                this.rth := DLeg.new(h, l)
                this.hasRth := true
            else
                this.rth.onBar(h, l, c, i_rangeMinLegTk * TICK, i_rangeReanchor)

// DealingRangeTracker.onCandle (1m)
method onCandle(DRange this, int t, float h, float l, float c) =>
    if not inHalt(t)
        int day = tradingDayKey(t)
        this.seq := this.seq + 1
        if na(this.tradingDay) or day != this.tradingDay
            bool roll = not na(this.tradingDay)
            bool nextCarried = false
            float nHi = na
            float nLo = na
            int nDir = 0
            if roll and i_rangeCarry
                [pd, ph, pl, peq, pdec] = this.snapshot()
                if pd != 0 and not na(ph) and not na(pl)
                    nextCarried := true
                    nHi := math.max(ph, h)
                    nLo := math.min(pl, l)
                    nDir := pd
            this.hasCarried := nextCarried
            this.cHi := nHi
            this.cLo := nLo
            this.cDir := nDir
            if nextCarried
                this.sessionLeg := DLeg.new(h, l)
            this.tradingDay := day
            if this.dir != 0
                this.carry := this.dir
                this.carryHi := this.hi
                this.carryLo := this.lo
            this.dir := 0
            this.hi := h
            this.lo := l
            this.hiSeq := this.seq
            this.loSeq := this.seq
            this.pullback := na
            this.hasRth := false
            this.onRthCandle(t, h, l, c)
        else
            this.onRthCandle(t, h, l, c)
            // onCarryCandle
            if this.hasCarried
                this.sessionLeg.onBar(h, l, c, i_rangeMinLegTk * TICK, i_rangeReanchor)
                if this.sessionLeg.dir != 0
                    this.hasCarried := false
                else
                    this.cHi := math.max(this.cHi, h)
                    this.cLo := math.min(this.cLo, l)
            if this.dir == 0
                if h > this.hi
                    this.hi := h
                    this.hiSeq := this.seq
                if l < this.lo
                    this.lo := l
                    this.loSeq := this.seq
                if this.hi - this.lo >= i_rangeMinPct / 100.0 * c
                    this.dir := this.hiSeq > this.loSeq ? 1 : -1
                    this.pullback := na
            else if this.dir < 0
                if c > this.hi
                    this.dir := 1
                    this.hi := h
                    this.pullback := na
                else if l < this.lo
                    if not na(this.pullback) and this.pullback - this.lo >= i_rangeReanchor * (this.hi - this.lo)
                        this.hi := this.pullback
                    this.lo := l
                    this.pullback := na
                else
                    if h > this.hi
                        this.hi := h
                    this.pullback := na(this.pullback) ? h : math.max(this.pullback, h)
            else
                if c < this.lo
                    this.dir := -1
                    this.lo := l
                    this.pullback := na
                else if h > this.hi
                    if not na(this.pullback) and this.hi - this.pullback >= i_rangeReanchor * (this.hi - this.lo)
                        this.lo := this.pullback
                    this.hi := h
                    this.pullback := na
                else
                    if l < this.lo
                        this.lo := l
                    this.pullback := na(this.pullback) ? l : math.min(this.pullback, l)

// ---------------------------------------------------------------- SMT (CorrelationTracker.hasSMTDivergence)
type Smt
    array<float> a      // primary (MNQ) 1m closes
    array<float> b      // correlate (MES) 1m closes

method pushA(Smt this, float c) =>
    this.a.push(c)
    if this.a.size() > i_smtLookback
        this.a.shift()

method pushB(Smt this, float c) =>
    this.b.push(c)
    if this.b.size() > i_smtLookback
        this.b.shift()

method diverges(Smt this) =>
    int n = i_smtLookback
    bool div = false
    if this.a.size() >= n and this.b.size() >= n
        float h1 = this.a.get(0)
        float l1 = this.a.get(0)
        float h2 = this.b.get(0)
        float l2 = this.b.get(0)
        for i = 0 to n - 2
            h1 := math.max(h1, this.a.get(i))
            l1 := math.min(l1, this.a.get(i))
            h2 := math.max(h2, this.b.get(i))
            l2 := math.min(l2, this.b.get(i))
        float x1 = this.a.get(n - 1)
        float x2 = this.b.get(n - 1)
        bool nh1 = x1 > h1
        bool nl1 = x1 < l1
        bool nh2 = x2 > h2
        bool nl2 = x2 < l2
        div := (nh1 and not nh2) or (nl1 and not nl2) or (nh2 and not nh1) or (nl2 and not nl1)
    div

// ---------------------------------------------------------------- setup state machine
const int ST_IDLE        = 0
const int ST_BIAS_SET    = 1
const int ST_SWEEP_DONE  = 3
const int ST_DISPLACED   = 4
const int ST_MSS         = 5
const int ST_OTE_ARMED   = 6
const int ST_IN_TRADE    = 7
const int ST_INVALIDATED = 9

stateName(int s) =>
    switch s
        ST_IDLE        => "IDLE"
        ST_BIAS_SET    => "BIAS_SET"
        ST_SWEEP_DONE  => "SWEEP_DONE"
        ST_DISPLACED   => "DISPLACED"
        ST_MSS         => "MSS_CONFIRMED"
        ST_OTE_ARMED   => "OTE_ARMED"
        ST_IN_TRADE    => "IN_TRADE"
        ST_INVALIDATED => "INVALIDATED"
        => "?"

type Machine
    int    state            = 0
    int    htfBias          = 0      // the SETUP's bias
    int    lastRecordedBias = 0      // StdvOteStrategy.lastRecordedBias
    int    lastBias         = 0      // runner lastBias (last 15m/30m read)
    int    neutralGrace     = 0
    int    createdAt        = na
    int    phaseState       = -1
    int    phaseAt          = 0
    int    barIndex         = 0      // core 1m bar counter
    // sweep
    bool   hasSweep         = false
    bool   swBull           = false
    float  swLevel          = na
    int    swTs             = na
    int    raidScore        = na
    int    raidKind         = na
    int    consumedRaidId   = na
    int    consumedSweepTs  = na
    // OteSetupDriver
    int    drvSweepTs       = na
    float  postHi           = na
    float  postLo           = na
    float  epHi             = na
    float  epLo             = na
    bool   hasSweepBar      = false
    int    sbT              = na
    float  sbO              = na
    float  sbH              = na
    float  sbL              = na
    float  sbC              = na
    array<int>   prT
    array<float> prO
    array<float> prH
    array<float> prL
    array<float> prC
    int    prevState        = 0
    int    dispIdx          = -1
    int    consumedDispTs   = na
    PdArr  linked
    PdArr  orderBlock
    int    mssIdx           = -1
    bool   impulseMode      = false
    float  impulseLevel     = na
    Zone   zone
    string model            = ""
    float  sweepExtreme     = na
    bool   alarmed          = false
    float  alarmEntry       = na
    string alarmKind        = ""
    float  alarmFar         = na
    int    alarmTs          = na
    int    armedTs          = na
    int    barsInOte        = 0
    int    rearmCD          = -1
    bool   closedAwaitingRearm = false
    bool   positionSeen     = false
    int    emitBar          = na
    string lastGate         = ""
    string verdict          = ""
    int    dispTs           = na
    int    mssTs            = na

newMachine() =>
    Machine.new(prT = array.new<int>(), prO = array.new<float>(), prH = array.new<float>(), prL = array.new<float>(), prC = array.new<float>(), zone = Zone.new())

method invalidate(Machine this, string why) =>
    this.state := ST_INVALIDATED
    this.lastGate := why

// StdvOteStrategy.recordHtfBias (bias.hysteresis, bias.neutralGraceBars)
method recordHtfBias(Machine this, int bias) =>
    this.lastRecordedBias := bias
    if this.htfBias != 0 and bias != 0 and bias != this.htfBias and this.state < ST_IN_TRADE
        this.invalidate("HTF bias flip")
    if bias == 0 and this.state != ST_IDLE and this.state < ST_IN_TRADE
        if not i_biasHysteresis
            this.invalidate("HTF bias became NEUTRAL")
        else
            this.neutralGrace := this.neutralGrace + 1
            if this.neutralGrace > i_neutralGrace
                this.invalidate("HTF bias NEUTRAL beyond grace")
    else
        this.neutralGrace := 0
        this.htfBias := bias
        if bias != 0 and this.state == ST_IDLE
            this.state := ST_BIAS_SET
            this.createdAt := this.barIndex

// StdvOteStrategy.resetForNextWindow + OteSetupDriver.afterCandle resets
method resetForNextWindow(Machine this) =>
    this.state := ST_IDLE
    this.htfBias := 0
    this.neutralGrace := 0
    this.createdAt := na
    this.hasSweep := false
    this.swLevel := na
    this.swTs := na
    this.raidScore := na
    this.raidKind := na
    this.zone := Zone.new()
    this.model := ""
    this.sweepExtreme := na
    this.alarmed := false
    this.alarmEntry := na
    this.alarmKind := ""
    this.alarmFar := na
    this.alarmTs := na
    this.armedTs := na
    this.barsInOte := 0
    this.positionSeen := false
    this.emitBar := na
    this.dispTs := na
    this.mssTs := na

method rearm(Machine this) =>
    this.closedAwaitingRearm := false
    this.resetForNextWindow()
    if this.lastBias != 0
        this.recordHtfBias(this.lastBias)

// StdvOteStrategy.onCandle expiry budgets (PHASED, minutes = 1m bars)
method expiry(Machine this) =>
    int s = this.state
    if s != this.phaseState
        this.phaseState := s
        this.phaseAt := this.barIndex
    this.barIndex := this.barIndex + 1
    if s == ST_SWEEP_DONE or s == ST_DISPLACED or s == ST_MSS
        int budget = s == ST_SWEEP_DONE ? i_sweepDispMin : s == ST_DISPLACED ? i_dispMssMin : i_mssOteMin
        if budget > 0 and this.barIndex - this.phaseAt > budget
            this.invalidate("expired: phase budget " + str.tostring(budget) + " min")
    else if s == ST_BIAS_SET
        if i_preSweepMin > 0 and not na(this.createdAt) and this.barIndex - this.createdAt > i_preSweepMin
            this.invalidate("expired before SWEEP_DONE")

// processLegacyRearm (setup.rearmCooldownBars; canRearm = not NO_ENTRY/WEEKEND and flat)
method processRearm(Machine this, int t) =>
    if this.state == ST_INVALIDATED and this.rearmCD < 0
        this.rearmCD := i_rearmCooldown
    else if this.rearmCD > 0
        this.rearmCD := this.rearmCD - 1
    else if this.rearmCD == 0 and (this.state == ST_INVALIDATED or (this.state == ST_IN_TRADE and this.closedAwaitingRearm)) and not sessionBlocksEntry(t) and strategy.position_size == 0
        this.rearmCD := -1
        this.rearm()

method trackEpisode(Machine this, float level, float h, float l) =>
    this.epHi := na(this.epHi) ? math.max(level, h) : math.max(this.epHi, math.max(level, h))
    this.epLo := na(this.epLo) ? math.min(level, l) : math.min(this.epLo, math.min(level, l))

method newSweepEpisode(Machine this) =>
    if this.prevState != ST_SWEEP_DONE or this.state != ST_SWEEP_DONE
        this.epHi := na
        this.epLo := na

// setSweepBar: the sweep 1m candle + the obLookbackBars 1m candles before it
method setSweepBar(Machine this, Feed1 f, int t, float o, float h, float l, float c) =>
    this.hasSweepBar := true
    this.sbT := t
    this.sbO := o
    this.sbH := h
    this.sbL := l
    this.sbC := c
    this.prT.clear()
    this.prO.clear()
    this.prH.clear()
    this.prL.clear()
    this.prC.clear()
    int n = f.t.size()
    if n > 0
        for k = n - 1 to 0
            if this.prT.size() >= i_obLookback
                break
            if f.t.get(k) < t
                this.prT.unshift(f.t.get(k))
                this.prO.unshift(f.o.get(k))
                this.prH.unshift(f.h.get(k))
                this.prL.unshift(f.l.get(k))
                this.prC.unshift(f.c.get(k))

method startSweepTracking(Machine this, Feed1 f, int t, float o, float h, float l, float c) =>
    this.newSweepEpisode()
    this.drvSweepTs := this.swTs
    this.postHi := math.max(this.swLevel, h)
    this.postLo := math.min(this.swLevel, l)
    this.setSweepBar(f, t, o, h, l, c)

// OteSetupDriver.onFeedCandle
method onFeedCandle(Machine this, Feed1 f, int t, float o, float h, float l, float c) =>
    if this.hasSweep
        if na(this.drvSweepTs) or this.drvSweepTs != this.swTs
            this.startSweepTracking(f, t, o, h, l, c)
        else
            this.postHi := math.max(this.postHi, h)
            this.postLo := math.min(this.postLo, l)
        this.trackEpisode(this.swLevel, h, l)

// OteSetupDriver.afterCandle
method afterCandle(Machine this) =>
    if this.state == ST_IDLE or this.state == ST_BIAS_SET
        this.dispIdx := -1
        this.linked := na
        this.orderBlock := na
        this.mssIdx := -1
        this.impulseMode := false
        this.impulseLevel := na
    if not this.hasSweep
        this.drvSweepTs := na
        this.postHi := na
        this.postLo := na
        this.hasSweepBar := false
        this.prT.clear()
        this.prO.clear()
        this.prH.clear()
        this.prL.clear()
        this.prC.clear()
        this.epHi := na
        this.epLo := na
    this.prevState := this.state

// tryRecordSweep (BIAS_SET acts as MANIP_DONE: the manipulation leg always exists — PORT_MAP L2 DROP)
method tryRecordSweep(Machine this, RaidState rs, LevelState lvs, Feed1 f, ScoreCtx ctx) =>
    if this.htfBias != 0
        bool wantLow = this.htfBias > 0
        [found, lvl, ts, sc, kind, rid, swTs] = rs.resolveSweep(lvs, f, ctx, wantLow, false, this.consumedRaidId, this.consumedSweepTs)
        if found and sc >= i_minRaidScore
            this.hasSweep := true
            this.swBull := wantLow
            this.swLevel := lvl
            this.swTs := ts
            this.raidScore := sc
            this.raidKind := kind
            this.state := ST_SWEEP_DONE
            if not na(rid)
                this.consumedRaidId := rid
            if not na(swTs)
                this.consumedSweepTs := swTs

// tryRefreshSweep: a NEWER level raid scoring >= floor and >= current replaces the sweep
method tryRefreshSweep(Machine this, RaidState rs, LevelState lvs, Feed1 f, ScoreCtx ctx) =>
    if this.htfBias != 0 and this.hasSweep
        bool wantLow = this.htfBias > 0
        [found, lvl, ts, sc, kind, rid, swTs] = rs.resolveSweep(lvs, f, ctx, wantLow, true, this.consumedRaidId, this.consumedSweepTs)
        if found and not na(rid) and sc >= i_minRaidScore and sc >= this.raidScore and ts > this.swTs
            this.swLevel := lvl
            this.swTs := ts
            this.raidScore := sc
            this.raidKind := kind
            this.consumedRaidId := rid

// OteSetupDriver.tryImpulseLegEntry -> true when the IMPULSE_LEG path consumed the candle
method tryImpulseLeg(Machine this, Buf5 b, Structure st, Feed1 f, float rHi, float rLo, int t, float o, float h, float l, float c) =>
    bool consumed = false
    if this.htfBias != 0 and this.hasSweep
        bool bull = this.htfBias > 0
        if this.swBull != bull
            this.verdict := "sweep-direction-mismatch"
        else if na(rHi) or na(rLo) or not (rHi > rLo)
            this.verdict := "no-dealing-range"
        else
            Zone z = buildZone(rLo, rHi, bull)
            if not z.valid
                this.verdict := "no-zone"
            else
                float lo = z.bandLo()
                float hi = z.bandHi()
                float level = this.swLevel
                if na(this.drvSweepTs) or this.drvSweepTs != this.swTs
                    this.startSweepTracking(f, t, o, h, l, c)
                this.trackEpisode(level, h, l)
                float ext = bull ? this.epLo : this.epHi
                float sz = rHi - rLo
                float need = bull ? rHi - i_minSweepFib * sz : rLo + i_minSweepFib * sz
                if level < lo - 1e-9 or level > hi + 1e-9
                    this.verdict := "sweep not in OTE band"
                else if na(ext) or ext < lo - 1e-9 or ext > hi + 1e-9
                    this.verdict := "retrace extreme outside the OTE band"
                else if bull ? ext > need + 1e-9 : ext < need - 1e-9
                    this.verdict := "sweep extreme short of minSweepFib"
                else if closedBeyondExtreme(z, c)
                    this.verdict := "close beyond the range 1.0"
                else
                    int endIdx = bull ? b.lastBarAt(rHi, true, b.lastIdx) : b.lastBarAt(rLo, false, b.lastIdx)
                    int startIdx = endIdx < 0 ? -1 : (bull ? b.lastBarAt(rLo, false, endIdx) : b.lastBarAt(rHi, true, endIdx))
                    if startIdx < 0 or endIdx < 0 or startIdx >= endIdx
                        this.verdict := "impulse leg not in the detector buffer"
                    else
                        int legStart = b.bT(startIdx)
                        int legEnd = b.bT(endIdx)
                        // M5: displacements on the leg; M6: first leg MSS with a displacement at/before it
                        MssEv pick = na
                        DispEv pickD = na
                        for e in st.mss
                            if na(pick) and e.bullish == bull and e.idx >= startIdx and e.idx <= endIdx
                                DispEv before = na
                                for d in st.disp
                                    if d.bullish == bull and d.ts >= legStart and d.ts <= legEnd and d.ts <= e.ts
                                        before := d
                                if not na(before)
                                    pick := e
                                    pickD := before
                        bool anyDisp = false
                        for d in st.disp
                            if d.bullish == bull and d.ts >= legStart and d.ts <= legEnd
                                anyDisp := true
                        if not anyDisp
                            this.verdict := "M5: no displacement on the impulse leg"
                        else if na(pick)
                            this.verdict := "M6: no structure break on the impulse leg at/after its displacement"
                        else
                            int dIdx = b.indexOf(pickD.ts)
                            PdArr fvg = na
                            if dIdx >= 0
                                PdArr lf = linkedFvg(b, dIdx, bull)
                                if not na(lf) and lf.at >= legStart and lf.at <= legEnd
                                    fvg := lf
                            if na(fvg)
                                fvg := gapInWindow(b, startIdx + 1, endIdx, bull)
                            if na(fvg)
                                this.verdict := "M5: no FVG created inside the impulse leg"
                            else
                                // SWEEP_DONE -> DISPLACED -> MSS_CONFIRMED -> OTE_ARMED on this candle
                                this.state := ST_OTE_ARMED
                                this.zone := z
                                this.model := "IMPULSE_LEG"
                                this.impulseMode := true
                                this.impulseLevel := level
                                this.sweepExtreme := ext
                                this.dispIdx := dIdx
                                this.mssIdx := pick.idx
                                this.linked := fvg
                                this.orderBlock := na
                                this.armedTs := t
                                this.dispTs := pickD.ts
                                this.mssTs := pick.ts
                                this.verdict := "ARMED (impulse leg)"
                                consumed := true
    consumed

// POST_SWEEP: OteSetupDriver.tryRecordDisplacement (non-impulse branch)
method tryRecordDisplacement(Machine this, Buf5 b, Structure st) =>
    bool bull = this.htfBias > 0
    int notBefore = na(this.swTs) ? na : this.swTs - 4 * MS_MIN
    DispEv d = st.findRecentDisp(b, i_dispRecent, bull, notBefore)
    if na(d)
        this.lastGate := st.anyRecentDisp(b, i_dispRecent, notBefore) ? "displacement-wrong-direction" : "no-recent-displacement"
    else if not na(this.consumedDispTs) and d.ts == this.consumedDispTs
        this.lastGate := "displacement-already-consumed"
    else
        int idx = b.indexOf(d.ts)
        if idx < 0
            this.lastGate := "no-displacement-object"
        else
            PdArr link = linkedFvg(b, idx, bull)
            bool pending = false
            if na(link)
                if not linkWindowClosed(b, idx)
                    pending := true
                    this.lastGate := "fvg-link-pending"
                else
                    link := orderBlockAt(b, idx, bull)
            if not pending
                if na(link)
                    this.lastGate := "no-fvg-for-displacement"
                else if link.bullish == bull
                    this.state := ST_DISPLACED
                    this.consumedDispTs := d.ts
                    this.dispIdx := idx
                    this.linked := link
                    this.orderBlock := orderBlockAt(b, idx, bull)
                    this.dispTs := d.ts

// POST_SWEEP: tryRecordMss (fresh MSS at/after the displacement; counter MSS through the extreme kills)
method tryRecordMss(Machine this, Buf5 b, Structure st) =>
    bool bull = this.htfBias > 0
    int n = st.mss.size()
    bool done = false
    if n > 0
        for k = n - 1 to 0
            if done
                break
            MssEv e = st.mss.get(k)
            if e.idx < this.dispIdx or b.lastIdx - e.idx > i_mssFreshBars
                break
            if e.bullish != bull
                float ext = bull ? this.postLo : this.postHi
                bool through = not na(ext) and (bull ? e.level < ext : e.level > ext)
                if through
                    this.invalidate("counter-bias MSS through the sweep extreme")
                    done := true
            else
                this.state := ST_MSS
                this.mssIdx := e.idx
                this.mssTs := e.ts
                done := true

// POST_SWEEP: plan + tryArmOte (range leg if the post-sweep extreme sits in the correct half, else the
// sweep-extreme -> furthest-price leg; recomputed every candle until armed)
method tryArmOte(Machine this, Buf5 b, float rHi, float rLo, int t, float h, float l, float c) =>
    bool bull = this.htfBias > 0
    bool usable = false
    if not na(rHi) and not na(rLo) and rHi > rLo
        float eq = (rLo + rHi) / 2.0
        usable := bull ? (na(this.postLo) or (this.postLo >= rLo - TICK and this.postLo <= eq)) : (na(this.postHi) or (this.postHi <= rHi + TICK and this.postHi >= eq))
    Zone z = Zone.new()
    if usable
        z := buildZone(rLo, rHi, bull)
    else if not na(this.postHi) and not na(this.postLo) and this.postHi > this.postLo
        z := buildZone(this.postLo, this.postHi, bull)
    if z.valid
        this.zone := z
        this.sweepExtreme := bull ? this.postLo : this.postHi
    if not this.zone.valid
        this.lastGate := "no-anchor-leg"
    else if closedBeyondExtreme(this.zone, c)
        this.invalidate("OTE invalidated: close beyond range extreme")
    else if this.mssIdx >= 0 and b.lastIdx - this.mssIdx > i_mssFreshBars
        this.invalidate("MSS stale before price reached the OTE band")
    else if tradedIntoBand(this.zone, h, l)
        this.state := ST_OTE_ARMED
        this.model := "POST_SWEEP"
        this.armedTs := t
    else
        this.lastGate := "awaiting-band-touch"

// IMPULSE_LEG PD-array candidates at the sweep
method impulseCandidates(Machine this, Buf5 b, bool bull) =>
    array<PdArr> out = array.new<PdArr>()
    float level = this.impulseLevel
    if not na(this.swTs)
        int barStart = math.floor(this.swTs / (5 * MS_MIN)) * (5 * MS_MIN)
        int sIdx = b.indexOf(barStart)
        if sIdx >= 0
            PdArr sob = sweepOrderBlock(b, sIdx, bull, level)
            if not na(sob)
                out.push(sob)
    if i_pdSource == "ICT_OB"
        int np = this.prT.size()
        if np > 0
            for k = np - 1 to 0
                bool opp = bull ? this.prC.get(k) < this.prO.get(k) : this.prC.get(k) > this.prO.get(k)
                if opp
                    out.push(PdArr.new("OB", bull, this.prL.get(k), this.prH.get(k), this.prT.get(k)))
                    break
    if this.hasSweepBar
        float rng = this.sbH - this.sbL
        float bTop = math.max(this.sbO, this.sbC)
        float bBot = math.min(this.sbO, this.sbC)
        bool rej = bull ? this.sbC > level : this.sbC < level
        float wick = bull ? bBot - this.sbL : this.sbH - bTop
        if rej and rng > 0 and wick / rng >= 0.5
            out.push(bull ? PdArr.new("WICK", true, this.sbL, bBot, this.sbT) : PdArr.new("WICK", false, bTop, this.sbH, this.sbT))
    array<PdArr> dc = pdCandidates(b, bull)
    for p in dc
        if bull ? p.bottom <= level : p.top >= level
            out.push(p)
    out

// OteSetupDriver.alarm -> true when an entry may be attempted on this candle
method alarm(Machine this, Buf5 b, int t, float o, float h, float l, float c) =>
    bool fire = false
    if this.state == ST_OTE_ARMED and this.zone.valid
        if sessionBlocksEntry(t)
            this.lastGate := "no-entry-block-15:45-18:00ET"
        else if this.alarmed
            fire := true
        else if closedBeyondExtreme(this.zone, c)
            this.invalidate("OTE invalidated: close beyond range extreme")
        else
            bool bull = this.zone.bullish
            bool impulse = this.impulseMode and this.model == "IMPULSE_LEG"
            if impulse
                this.sweepExtreme := bull ? this.epLo : this.epHi
            array<PdArr> cands = array.new<PdArr>()
            if impulse
                cands := this.impulseCandidates(b, bull)
            else
                if not na(this.linked)
                    cands.push(this.linked)
                if not na(this.orderBlock)
                    cands.push(this.orderBlock)
                for p in pdCandidates(b, bull)
                    cands.push(p)
            PdArr best = bestInBand(cands, this.zone)
            if na(best)
                this.lastGate := impulse ? "impulse-no-pd-array-at-sweep" : "no-pd-array-overlapping-band"
            else
                bool react = impulse ? reactionImpulse(this.zone, o, h, l, c, this.impulseLevel) : reactionPostSweep(this.zone, o, h, l, c)
                if not react
                    this.lastGate := impulse ? "impulse-awaiting-rejection" : "no-reaction-at-band"
                else
                    this.alarmed := true
                    this.alarmEntry := roundTick(pdEntryLevel(best, this.zone))
                    this.alarmKind := best.kind
                    this.alarmFar := best.farEdge()
                    this.alarmTs := t
                    fire := true
    fire

// StdvOteStrategy.tryEmit + MandatoryConfluenceValidator (M2b, M3, M4, M7; M8 size = Agent 03).
// Returns [emitted, entry, stop, t1, t2, t3, final, rrT1, rrFinal].
method tryEmit(Machine this, int t, float rHi, float rLo, float rEq, bool rDec) =>
    bool ok = false
    float entry = na
    float stop = na
    float t1 = na
    float t2 = na
    float t3 = na
    float fin = na
    float rrT1 = na
    float rrFin = na
    if this.state == ST_OTE_ARMED and this.zone.valid
        if this.lastRecordedBias == 0 or this.lastRecordedBias != this.htfBias
            this.lastGate := "BIAS: emission blocked (current bias not aligned with setup)"
        else
            Zone z = this.zone
            bool bull = z.bullish
            // OteEntryCalculator.chooseEntry: the PD-array level when inside the band, else the 0.705
            entry := z.contains(this.alarmEntry) ? roundTick(this.alarmEntry) : z.f705
            // StdvOteStrategy.anchoredStop (ote.stopMode = BAND)
            float far = z.f79
            bool impulse = this.model == "IMPULSE_LEG"
            if bull
                if not na(this.alarmFar)
                    far := math.min(far, this.alarmFar)
                if impulse and not na(this.sweepExtreme)
                    far := math.min(far, this.sweepExtreme)
                stop := roundTick(far - i_stopBufTicks * TICK)
            else
                if not na(this.alarmFar)
                    far := math.max(far, this.alarmFar)
                if impulse and not na(this.sweepExtreme)
                    far := math.max(far, this.sweepExtreme)
                stop := roundTick(far + i_stopBufTicks * TICK)
            // targetLadder [0.5, 0.382, 0.0]; final = the LAST rung (in that order) with RR <= ceiling, default T1
            t1 := z.fibLevel(0.5)
            t2 := z.fibLevel(0.382)
            t3 := z.fibLevel(0.0)
            fin := t1
            if rewardToRisk(entry, stop, t2) <= i_rrMax + 1e-9
                fin := t2
            if rewardToRisk(entry, stop, t3) <= i_rrMax + 1e-9
                fin := t3
            rrT1 := rewardToRisk(entry, stop, t1)
            rrFin := rewardToRisk(entry, stop, fin)
            // M2b premium/discount vs the governing range eq (RD branch; other branches ABSTAIN = pass)
            bool m2b = true
            if i_pdGateOn and rDec and not na(rEq) and not na(rHi) and not na(rLo) and (rHi - rLo) >= i_pdMinRangeTicks * TICK
                float band = i_pdEqBandTicks * TICK
                m2b := bull ? entry < rEq - band : entry > rEq + band
            bool m3 = not sessionBlocksEntry(t)
            bool m4 = not na(this.raidScore) and this.raidScore >= i_minRaidScore
            bool m7 = z.contains(entry) and rrT1 >= i_rrMin - 1e-9 and rrFin <= i_rrMax + 1e-9 and (bull ? stop < entry : stop > entry)
            if not m2b
                this.lastGate := "GATE-M2b premium/discount"
            else if not m3
                this.lastGate := "GATE-M3 session"
            else if not m4
                this.lastGate := "GATE-M4 raid score"
            else if not m7
                this.lastGate := "GATE-M7 OTE/RR"
            else
                ok := true
                this.lastGate := ""
                this.state := ST_IN_TRADE
                this.emitBar := bar_index
                this.positionSeen := false
    [ok, entry, stop, t1, t2, t3, fin, rrT1, rrFin]

// =============================================================================
// ENGINE — replay the 1m intrabars of every CONFIRMED 5m bar (I8: nothing evaluates intrabar).
// request.security_lower_tf returns the 1m bars INSIDE the current chart bar, oldest first; it has
// no lookahead parameter and on a confirmed bar its contents are final. MES is read the same way
// for SMT and is DATA ONLY — never traded (I1). When a bar has no intrabar data (history older than
// the plan's intrabar limit) the 5m bar itself is replayed as one pseudo-1m candle (PORT_APPROX).
// =============================================================================
[ltT, ltO, ltH, ltL, ltC] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, high, low, close])
[mesT, mesC] = request.security_lower_tf(i_smtSymbol, "1", [time, close], ignore_invalid_symbol = true)

if barstate.isfirst and timeframe.period != "5"
    runtime.error("LucidICT V6 runs on a 5-minute chart (EngineConfig stdvote.detectorTimeframe = 5).")

var LevelState lvs   = newLevelState()
var Feed1      feed  = newFeed1()
var RaidState  raids = newRaidState()
var Buf5       buf   = newBuf5()
var Structure  st    = newStructure()
var DRange     dr    = DRange.new(rth = DLeg.new(), sessionLeg = DLeg.new())
var Smt        smtS  = Smt.new(array.new<float>(), array.new<float>())
var Machine    m     = newMachine()
var int        last15Bucket = na
var bool       smtNow  = false
var int        rDirNow = 0
var float      rHiNow  = na
var float      rLoNow  = na
var float      rEqNow  = na
var bool       rDecNow = false

// per-bar signal outputs (reset every bar)
bool   coreSignalLong  = false
bool   coreSignalShort = false
float  sigEntryRef     = na    // Java LIMIT entry (PD-array level) — parity reference (PORT_MAP S1)
float  sigStop         = na
float  sigT1           = na
float  sigT2           = na
float  sigT3           = na
float  sigFinal        = na
float  sigRrT1         = na
float  sigRrFinal      = na
string sigPdKind       = ""
string sigModel        = ""
string sigLevelType    = ""
int    sigRaidScore    = na
int    sigTs1m         = na    // open time of the 1m candle on which Java would emit
int    sigSession      = na

if barstate.isconfirmed
    raids.dbgT.clear()
    raids.dbgP.clear()
    raids.dbgS.clear()
    raids.dbgLow.clear()
    // IN_TRADE latch release (processLegacyRearm: pendingPositionClosed / executedSinceEmit)
    if m.state == ST_IN_TRADE
        if strategy.position_size != 0
            m.positionSeen := true
        else if bar_index > m.emitBar and not m.closedAwaitingRearm
            if not m.positionSeen
                m.invalidate("signal not executed (released)")
            else
                m.closedAwaitingRearm := true
                m.rearmCD := i_rearmCooldown
    int nLtf = na(ltT) ? 0 : ltT.size()
    bool useLtf = nLtf > 0
    int cnt = useLtf ? nLtf : 1
    int nMes = na(mesT) ? 0 : mesT.size()
    int mesPtr = 0
    for i = 0 to cnt - 1
        int   t1m = useLtf ? ltT.get(i) : time
        float o1m = useLtf ? ltO.get(i) : open
        float h1m = useLtf ? ltH.get(i) : high
        float l1m = useLtf ? ltL.get(i) : low
        float c1m = useLtf ? ltC.get(i) : close
        // 1. LiquidityDetector.updatePrimary
        feed.add(t1m, o1m, h1m, l1m, c1m)
        raids.detectSwingSweep(feed)
        // 2. LevelEngine.processCandle
        lvs.processCandle(t1m, h1m, l1m)
        // 3. the 5m anatomy bar completed by the first 1m of this bucket: displacement, MSS, PD arrays
        if i == 0 and bar_index > 0
            buf.add(time[1], open[1], high[1], low[1], close[1])
            st.detectDisplacement(buf)
            [nh, nhp, nl, nlp] = st.updateMss(buf)
            if nh
                lvs.onSwingPoint(true, nhp)
            if nl
                lvs.onSwingPoint(false, nlp)
        // 4. OteSetupDriver.onFeedCandle
        m.onFeedCandle(feed, t1m, o1m, h1m, l1m, c1m)
        // 5. SMT (CorrelationTracker): correlate closes up to this minute first
        if nMes > 0
            while mesPtr < nMes and mesT.get(mesPtr) <= t1m
                smtS.pushB(mesC.get(mesPtr))
                mesPtr += 1
        smtS.pushA(c1m)
        smtNow := i_smtEnabled and smtS.diverges()
        // 6. DealingRangeTracker.onCandle
        dr.onCandle(t1m, h1m, l1m, c1m)
        [rd, rh, rl, re, rdec] = dr.snapshot()
        rDirNow := rd
        rHiNow  := rh
        rLoNow  := rl
        rEqNow  := re
        rDecNow := rdec
        // 7. RaidDetector.processCandle with this candle's scoring context
        int scoringBias = m.htfBias != 0 ? m.htfBias : m.lastBias
        bool dispEntry = scoringBias != 0 and st.dispEntryTrigger(buf, scoringBias > 0)
        ScoreCtx ctx = ScoreCtx.new(scoringBias, smtNow, dispEntry, rdec ? re : na, isRaidKillzone(t1m), isSilverBullet(t1m))
        raids.processCandle(lvs, feed, t1m, o1m, h1m, l1m, c1m, ctx)
        // 8. core.onCandle (expiry) + re-arm
        m.expiry()
        m.processRearm(t1m)
        // 9. bias on each completed 15m/30m bar (= the first 1m of a new 15m bucket)
        int b15 = math.floor(t1m / (15 * MS_MIN))
        if not na(last15Bucket) and b15 != last15Bucket
            int biasNow = rdec ? rd : 0       // bias.source = RANGE; the vote is cold-start only (PORT_MAP B2)
            m.recordHtfBias(biasNow)
            m.lastBias := biasNow
        last15Bucket := b15
        // 10. OTE window (ote.windowBars x 5 feed bars)
        if m.state == ST_OTE_ARMED
            m.barsInOte := m.barsInOte + 1
            if m.barsInOte > i_oteWindowBars * 5
                m.invalidate("OTE window expired")
                m.barsInOte := 0
        else
            m.barsInOte := 0
        // 11. state transitions (one candle may chain several, exactly like the runner)
        if m.state == ST_BIAS_SET
            m.tryRecordSweep(raids, lvs, feed, ctx)
        else if m.state == ST_SWEEP_DONE
            m.tryRefreshSweep(raids, lvs, feed, ctx)
        if m.state == ST_SWEEP_DONE
            bool took = false
            if i_entryModel == "IMPULSE_LEG"
                took := m.tryImpulseLeg(buf, st, feed, rh, rl, t1m, o1m, h1m, l1m, c1m)
            if not took and m.state == ST_SWEEP_DONE
                m.tryRecordDisplacement(buf, st)
        if m.state == ST_DISPLACED
            m.tryRecordMss(buf, st)
        if m.state == ST_MSS
            m.tryArmOte(buf, rh, rl, t1m, h1m, l1m, c1m)
        if m.state == ST_OTE_ARMED
            if m.alarm(buf, t1m, o1m, h1m, l1m, c1m)
                [ok, en, sp, a1, a2, a3, fi, r1, rf] = m.tryEmit(t1m, rh, rl, re, rdec)
                if ok
                    coreSignalLong  := m.zone.bullish
                    coreSignalShort := not m.zone.bullish
                    sigEntryRef  := en
                    sigStop      := sp
                    sigT1        := a1
                    sigT2        := a2
                    sigT3        := a3
                    sigFinal     := fi
                    sigRrT1      := r1
                    sigRrFinal   := rf
                    sigPdKind    := m.alarmKind
                    sigModel     := m.model
                    sigLevelType := levelName(m.raidKind)
                    sigRaidScore := m.raidScore
                    sigTs1m      := t1m
                    sigSession   := sessionWindow(t1m)
        // 12. OteSetupDriver.afterCandle
        m.afterCandle()

// =============================================================================
// EXPORTS — named series for Agent 03 (80_strategy) and the debug overlay (95).
// Values are final at the confirmed 5m close; consume them only when barstate.isconfirmed.
// =============================================================================
int    bias             = m.lastBias                          // +1 BULLISH / -1 BEARISH / 0 NEUTRAL (last 15m read)
int    setupBias        = m.htfBias                           // the setup's bias
int    setupState       = m.state                             // ST_* constant
string setupStateName   = stateName(m.state)
int    raidScore        = m.raidScore                         // M4 score of the setup's sweep (na before SWEEP_DONE)
string raidLevelType    = na(m.raidKind) ? "" : levelName(m.raidKind)
bool   sweepDone        = m.hasSweep
float  sweptLevel       = m.swLevel
bool   displaced        = m.state >= ST_DISPLACED and m.state <= ST_IN_TRADE
bool   mssConfirmed     = m.state >= ST_MSS and m.state <= ST_IN_TRADE
bool   oteArmed         = m.state == ST_OTE_ARMED
float  oteLow           = m.zone.valid ? m.zone.bandLo() : na   // OTE band low  (min of f62/f79)
float  oteHigh          = m.zone.valid ? m.zone.bandHi() : na   // OTE band high (max of f62/f79)
float  ote705           = m.zone.valid ? m.zone.f705 : na
float  oteEq            = m.zone.valid ? m.zone.eq50 : na
float  oteInvalidation  = m.zone.valid ? m.zone.one00 : na
bool   smt              = smtNow                              // SMT divergence on the last 1m of this bar
int    rangeDir         = rDirNow                             // dealing range (PORT_MAP B1)
float  rangeHigh        = rHiNow
float  rangeLow         = rLoNow
float  rangeEq          = rEqNow
bool   rangeDecisive    = rDecNow
string lastGateFailed   = m.lastGate
string impulseVerdict   = m.verdict
int    sessionNow       = sessionWindow(time)
bool   primeKillzoneNow = isPrimeKillzone(time)
// ==== file: 80_strategy.pine ====
// =============================================================================
// 80_strategy — OWNED BY AGENT 03 (V6 tasks 03.1-03.8). STUB from Agent 02.
// Consumes the EXPORTS of 70_bias_smt (coreSignalLong/coreSignalShort, sigEntryRef, sigStop,
// sigT1/sigT2/sigT3/sigFinal, sigRrT1/sigRrFinal, raidScore, mssConfirmed, oteLow/oteHigh, bias,
// smt, rangeHigh/rangeLow/rangeEq, sessionNow) and the [Time] helpers of 20_time
// (isNoEntryTime, isFlattenTime, inManualBlackout, sessionAllowed).
// Contract enforced by tools/pine_lint.py for every entry added here:
//   * strategy.entry only inside an `if barstate.isconfirmed` block (I8)
//   * each strategy.entry id has a strategy.exit(..., from_entry = <same id>, stop = ...) (I2)
//   * no order call references the SMT symbol or any request.* result (I1)
// No orders are placed by this stub.
// =============================================================================
// ==== file: 90_alerts.pine ====
// =============================================================================
// 90_alerts — OWNED BY AGENT 04 (V6 tasks 04.1-04.6). STUB from Agent 02.
// Relay payload builders (alert_message on every strategy.entry / strategy.exit / close_all).
// Never put a secret, webhook URL or account id in a default value, comment or plot (R5 / AP-9).
// =============================================================================
// ==== file: 95_debug.pine ====
// =============================================================================
// 95_debug — optional overlay (task 02.5). Off by default; draws nothing unless enabled.
// Raid markers with score, the OTE band, the dealing-range eq, the MSS line, core signal
// markers at the Java reference entry, and a gate table on the last bar — enough to eyeball
// a G1 replay (2026-09-28 14:53 ET SELL, LONDON_HIGH score 10, band [30605.5; 30673.0]).
// =============================================================================
pHiOte = plot(i_dbgOverlay ? oteHigh : na, "OTE high", color = color.new(color.orange, 0), style = plot.style_linebr)
pLoOte = plot(i_dbgOverlay ? oteLow : na, "OTE low", color = color.new(color.orange, 0), style = plot.style_linebr)
fill(pHiOte, pLoOte, color = color.new(color.orange, 85), title = "OTE band")
plot(i_dbgOverlay ? ote705 : na, "OTE 0.705", color = color.new(color.orange, 40), style = plot.style_linebr)
plot(i_dbgOverlay and rangeDecisive ? rangeEq : na, "Range eq", color = color.new(color.gray, 30), style = plot.style_linebr)
plot(i_dbgOverlay ? rangeHigh : na, "Range high", color = color.new(color.gray, 60), style = plot.style_linebr)
plot(i_dbgOverlay ? rangeLow : na, "Range low", color = color.new(color.gray, 60), style = plot.style_linebr)
plotshape(i_dbgOverlay and coreSignalLong, "Core long", shape.triangleup, location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(i_dbgOverlay and coreSignalShort, "Core short", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small)
plot(i_dbgOverlay and (coreSignalLong or coreSignalShort) ? sigEntryRef : na, "Java entry ref", color = color.new(color.blue, 0), style = plot.style_circles, linewidth = 3)
plot(i_dbgOverlay and (coreSignalLong or coreSignalShort) ? sigStop : na, "Signal stop", color = color.new(color.red, 0), style = plot.style_cross, linewidth = 2)
plot(i_dbgOverlay and (coreSignalLong or coreSignalShort) ? sigT1 : na, "Signal T1", color = color.new(color.green, 0), style = plot.style_cross, linewidth = 2)

var int dbgLastMssTs = na
if i_dbgOverlay and barstate.isconfirmed
    int nr = raids.dbgT.size()
    if nr > 0
        for k = 0 to nr - 1
            bool lowR = raids.dbgLow.get(k)
            label.new(raids.dbgT.get(k), raids.dbgP.get(k), "raid " + str.tostring(raids.dbgS.get(k)), xloc = xloc.bar_time, style = lowR ? label.style_label_up : label.style_label_down, color = lowR ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.tiny)
    if not na(st.dbgMssTs) and (na(dbgLastMssTs) or st.dbgMssTs != dbgLastMssTs)
        dbgLastMssTs := st.dbgMssTs
        line.new(st.dbgMssTs - 10 * 5 * MS_MIN, st.dbgMssLevel, st.dbgMssTs, st.dbgMssLevel, xloc = xloc.bar_time, color = st.dbgMssBull ? color.new(color.green, 0) : color.new(color.red, 0), style = line.style_dashed, width = 1)
    if coreSignalLong or coreSignalShort
        label.new(bar_index, coreSignalLong ? low : high, (coreSignalLong ? "BUY " : "SELL ") + sigModel + " " + sigPdKind + "\nref " + str.tostring(sigEntryRef, format.mintick) + " stop " + str.tostring(sigStop, format.mintick) + "\nT1 " + str.tostring(sigT1, format.mintick) + " RR " + str.tostring(sigRrT1, "#.##") + "\n" + sigLevelType + " score " + str.tostring(sigRaidScore), style = coreSignalLong ? label.style_label_up : label.style_label_down, color = color.new(color.blue, 10), textcolor = color.white, size = size.small)

var table gateTbl = table.new(position.top_right, 2, 14, bgcolor = color.new(color.black, 20), border_width = 1)
if i_dbgTable and barstate.islast
    table.cell(gateTbl, 0, 0, "state", text_color = color.white)
    table.cell(gateTbl, 1, 0, setupStateName, text_color = color.white)
    table.cell(gateTbl, 0, 1, "bias / setup", text_color = color.white)
    table.cell(gateTbl, 1, 1, str.tostring(bias) + " / " + str.tostring(setupBias), text_color = color.white)
    table.cell(gateTbl, 0, 2, "range", text_color = color.white)
    table.cell(gateTbl, 1, 2, "[" + str.tostring(rangeLow, format.mintick) + "; " + str.tostring(rangeHigh, format.mintick) + "] dec=" + str.tostring(rangeDecisive), text_color = color.white)
    table.cell(gateTbl, 0, 3, "M4 raid", text_color = color.white)
    table.cell(gateTbl, 1, 3, raidLevelType + " " + str.tostring(raidScore), text_color = color.white)
    table.cell(gateTbl, 0, 4, "M5 displaced", text_color = color.white)
    table.cell(gateTbl, 1, 4, str.tostring(displaced), text_color = color.white)
    table.cell(gateTbl, 0, 5, "M6 MSS", text_color = color.white)
    table.cell(gateTbl, 1, 5, str.tostring(mssConfirmed), text_color = color.white)
    table.cell(gateTbl, 0, 6, "M7 OTE band", text_color = color.white)
    table.cell(gateTbl, 1, 6, "[" + str.tostring(oteLow, format.mintick) + "; " + str.tostring(oteHigh, format.mintick) + "]", text_color = color.white)
    table.cell(gateTbl, 0, 7, "SMT", text_color = color.white)
    table.cell(gateTbl, 1, 7, str.tostring(smt), text_color = color.white)
    table.cell(gateTbl, 0, 8, "session", text_color = color.white)
    table.cell(gateTbl, 1, 8, sessionName(sessionNow) + (primeKillzoneNow ? " (prime KZ)" : ""), text_color = color.white)
    table.cell(gateTbl, 0, 9, "last gate", text_color = color.white)
    table.cell(gateTbl, 1, 9, lastGateFailed, text_color = color.white)
    table.cell(gateTbl, 0, 10, "impulse", text_color = color.white)
    table.cell(gateTbl, 1, 10, impulseVerdict, text_color = color.white)
