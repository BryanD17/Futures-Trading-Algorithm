// =============================================================================
// 95_debug — optional overlay (task 02.5). Off by default; draws nothing unless enabled.
// Raid markers with score, the OTE band, the dealing-range eq, the MSS line, core signal
// markers at the Java reference entry, and a gate table on the last bar — enough to eyeball
// a G1 replay (2026-09-28 14:53 ET SELL, LONDON_HIGH score 10, band [30605.5; 30673.0]).
// =============================================================================
pHiOte = plot(i_dbgOverlay ? oteHigh : na, "OTE high", color = color.new(color.orange, 0), style = plot.style_linebr)
pLoOte = plot(i_dbgOverlay ? oteLow : na, "OTE low", color = color.new(color.orange, 0), style = plot.style_linebr)
fill(pHiOte, pLoOte, color = color.new(color.orange, 85), title = "OTE band")
plot(i_dbgOverlay ? ote705 : na, "OTE 0.705", color = color.new(color.orange, 40), style = plot.style_linebr)
plot(i_dbgOverlay and rangeDecisive ? rangeEq : na, "Range eq", color = color.new(color.gray, 30), style = plot.style_linebr)
plot(i_dbgOverlay ? rangeHigh : na, "Range high", color = color.new(color.gray, 60), style = plot.style_linebr)
plot(i_dbgOverlay ? rangeLow : na, "Range low", color = color.new(color.gray, 60), style = plot.style_linebr)
plotshape(i_dbgOverlay and coreSignalLong, "Core long", shape.triangleup, location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(i_dbgOverlay and coreSignalShort, "Core short", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small)
plot(i_dbgOverlay and (coreSignalLong or coreSignalShort) ? sigEntryRef : na, "Java entry ref", color = color.new(color.blue, 0), style = plot.style_circles, linewidth = 3)
plot(i_dbgOverlay and (coreSignalLong or coreSignalShort) ? sigStop : na, "Signal stop", color = color.new(color.red, 0), style = plot.style_cross, linewidth = 2)
plot(i_dbgOverlay and (coreSignalLong or coreSignalShort) ? sigT1 : na, "Signal T1", color = color.new(color.green, 0), style = plot.style_cross, linewidth = 2)

var int dbgLastMssTs = na
if i_dbgOverlay and barstate.isconfirmed
    int nr = raids.dbgT.size()
    if nr > 0
        for k = 0 to nr - 1
            bool lowR = raids.dbgLow.get(k)
            label.new(raids.dbgT.get(k), raids.dbgP.get(k), "raid " + str.tostring(raids.dbgS.get(k)), xloc = xloc.bar_time, style = lowR ? label.style_label_up : label.style_label_down, color = lowR ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.tiny)
    if not na(anat.dbgMssTs) and (na(dbgLastMssTs) or anat.dbgMssTs != dbgLastMssTs)
        dbgLastMssTs := anat.dbgMssTs
        line.new(anat.dbgMssTs - 10 * 5 * MS_MIN, anat.dbgMssLevel, anat.dbgMssTs, anat.dbgMssLevel, xloc = xloc.bar_time, color = anat.dbgMssBull ? color.new(color.green, 0) : color.new(color.red, 0), style = line.style_dashed, width = 1)
    if coreSignalLong or coreSignalShort
        label.new(bar_index, coreSignalLong ? low : high, (coreSignalLong ? "BUY " : "SELL ") + sigModel + " " + sigPdKind + "\nref " + str.tostring(sigEntryRef, format.mintick) + " stop " + str.tostring(sigStop, format.mintick) + "\nT1 " + str.tostring(sigT1, format.mintick) + " RR " + str.tostring(sigRrT1, "#.##") + "\n" + sigLevelType + " score " + str.tostring(sigRaidScore), style = coreSignalLong ? label.style_label_up : label.style_label_down, color = color.new(color.blue, 10), textcolor = color.white, size = size.small)

var table gateTbl = table.new(position.top_right, 2, 14, bgcolor = color.new(color.black, 20), border_width = 1)
if i_dbgTable and barstate.islast
    table.cell(gateTbl, 0, 0, "state", text_color = color.white)
    table.cell(gateTbl, 1, 0, setupStateName, text_color = color.white)
    table.cell(gateTbl, 0, 1, "bias / setup", text_color = color.white)
    table.cell(gateTbl, 1, 1, str.tostring(bias) + " / " + str.tostring(setupBias), text_color = color.white)
    table.cell(gateTbl, 0, 2, "range", text_color = color.white)
    table.cell(gateTbl, 1, 2, "[" + str.tostring(rangeLow, format.mintick) + "; " + str.tostring(rangeHigh, format.mintick) + "] dec=" + str.tostring(rangeDecisive), text_color = color.white)
    table.cell(gateTbl, 0, 3, "M4 raid", text_color = color.white)
    table.cell(gateTbl, 1, 3, raidLevelType + " " + str.tostring(raidScore), text_color = color.white)
    table.cell(gateTbl, 0, 4, "M5 displaced", text_color = color.white)
    table.cell(gateTbl, 1, 4, str.tostring(displaced), text_color = color.white)
    table.cell(gateTbl, 0, 5, "M6 MSS", text_color = color.white)
    table.cell(gateTbl, 1, 5, str.tostring(mssConfirmed), text_color = color.white)
    table.cell(gateTbl, 0, 6, "M7 OTE band", text_color = color.white)
    table.cell(gateTbl, 1, 6, "[" + str.tostring(oteLow, format.mintick) + "; " + str.tostring(oteHigh, format.mintick) + "]", text_color = color.white)
    table.cell(gateTbl, 0, 7, "SMT", text_color = color.white)
    table.cell(gateTbl, 1, 7, str.tostring(smt), text_color = color.white)
    table.cell(gateTbl, 0, 8, "session", text_color = color.white)
    table.cell(gateTbl, 1, 8, sessionName(sessionNow) + (primeKillzoneNow ? " (prime KZ)" : ""), text_color = color.white)
    table.cell(gateTbl, 0, 9, "last gate", text_color = color.white)
    table.cell(gateTbl, 1, 9, lastGateFailed, text_color = color.white)
    table.cell(gateTbl, 0, 10, "impulse", text_color = color.white)
    table.cell(gateTbl, 1, 10, impulseVerdict, text_color = color.white)
