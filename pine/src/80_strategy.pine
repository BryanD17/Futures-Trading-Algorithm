// =============================================================================
// 80_strategy — OWNED BY AGENT 03 (V6 tasks 03.1-03.8): order envelope, sizing, AccountProfile caps.
// Consumes the EXPORTS of 70_bias_smt (coreSignalLong/coreSignalShort, sigEntryRef, sigStop, sigT1,
// sigRrT1/sigRrFinal, sigTs1m, ...) and the [Time] helpers of 20_time. The V5 mandatory chain
// (bias -> raid score >= floor -> displacement -> MSS -> OTE/PD array -> M2b/M3/M4/M7 incl. RR band vs
// the Java entry reference) is decided inside 70 (03.1); this file decides WHETHER the confirmed
// signal becomes an order and with WHAT size/stop/target, and enforces I1/I3/I4/I5/I6/I7 in Pine (L1).
//
// Exit model (PORT_MAP S3 / X2 decision, Agent 03): ONE bracket per entry = stop + T1 for the FULL
// quantity. The relay sends it as one native Tradovate OSO (I2, PLATFORM_FACTS B3). No partials, no
// breakeven move, no trailing (X3) in V6 -> nothing at the broker ever needs modifying.
//
// Lint contract (tools/pine_lint.py): every strategy.entry is inside `if barstate.isconfirmed` (I8),
// every entry id has strategy.exit(from_entry = <id>, stop = ...) (I2), no order touches request.* (I1).
// Relay contract (Agent 04): EVERY order call passes alert_message = orderAlert(...) — an empty
// alert_message fails the CrossTrade alert (PLATFORM_FACTS: "the empty payload makes the alert fail").
// tools/tests/test_pine_strategy.py fails the build if any order call misses it.
// =============================================================================

// ---- AGENT 04 HOOK — orderAlert(kind, dir, qty, stopPx, tpPx, why) now lives in 75_payload.pine (sorted
// before 80 so Pine resolves it). Same signature; builds the relay payload (CROSSTRADE | PICKMYTRADE |
// TRADERSPOST) and never returns "". kind: ENTRY | BRACKET | FLATTEN | SOFT_STOP.

// ---- pure helpers (every one is exercised by the 03.8 self-test below)
const int MS_SEC = 1000   // ms per second (unit constant, not a plan number)

// I4 micro-equivalents: 1 mini = 10 micros (LUCID_RULES: "N minis or 10N micros"). V6 trades MNQ (micro).
microsPerContract(string root) =>
    (root == "NQ" or root == "ES") ? 10 : 1

// 03.3 / I4: contracts = floor(budget / (stopTicks x tickValue)) then capped. The stop distance is the
// LARGER of (Java ref -> stop) and (fill -> stop) so a market fill never risks more than the budget and
// the Java size is reproduced whenever the fill is no further from the stop than the Java limit.
sizeContracts(float budget, float refPx, float fillPx, float stopPx, float tick, float tickValue, int capMicros, int mpc) =>
    int q = 0
    if not na(budget) and not na(stopPx) and not na(fillPx) and budget > 0 and tick > 0 and tickValue > 0 and mpc > 0
        float dist = na(refPx) ? math.abs(fillPx - stopPx) : math.max(math.abs(refPx - stopPx), math.abs(fillPx - stopPx))
        int stopTicks = int(math.round(dist / tick))
        if stopTicks > 0
            int riskQty = int(math.floor(budget / (stopTicks * tickValue) + 1e-9))
            int capC = int(math.floor(float(capMicros) / float(mpc) + 1e-9))
            q := math.max(0, math.min(riskQty, capC))
    q

// I6 + bracket sanity at the REAL fill: "" = ok, else the reason.
bracketReason(int dir, float fillPx, float stopPx, float tpPx, float tick, int minStopT, int minT1T) =>
    string r = ""
    if na(fillPx) or na(stopPx) or na(tpPx)
        r := "BRACKET na"
    else if dir > 0 and not (stopPx < fillPx and tpPx > fillPx)
        r := "BRACKET wrong side of fill (long)"
    else if dir < 0 and not (stopPx > fillPx and tpPx < fillPx)
        r := "BRACKET wrong side of fill (short)"
    else if math.round(math.abs(fillPx - stopPx) / tick) < minStopT
        r := "I6 stop < minStopTicks"
    else if math.round(math.abs(tpPx - fillPx) / tick) < minT1T
        r := "I6 T1 < minT1Ticks"
    r

// I3 outer limits (YAML common.v6_*): no entry in [16:30, 18:00) ET, flatten in [16:40, 18:00) ET.
hardNoEntry(int t) =>
    inWin(etMin(t), hhmmToMin(V6_HARD_NO_ENTRY_HHMM), 18 * 60)
hardFlatten(int t) =>
    inWin(etMin(t), hhmmToMin(V6_HARD_FLATTEN_HHMM), 18 * 60)
flattenNow(int t) =>
    isFlattenTime(t) or hardFlatten(t)
fridayLate(int t) =>
    dayofweek(t, TZ) == dayofweek.friday and inWin(etMin(t), hhmmToMin(i_fridayFlatAt), 18 * 60)
entryTimeBlocked(int t) =>
    isNoEntryTime(t) or hardNoEntry(t) or fridayLate(t) or flattenNow(t)

// I5: min seconds between any two orders (na = no previous order)
spacingOk(int lastMs, int nowMs, int sec) =>
    na(lastMs) or nowMs - lastMs >= sec * MS_SEC
// I6: a strategy-initiated exit only once the position is >= sec old
holdOk(int entryMs, int nowMs, int sec) =>
    na(entryMs) or nowMs - entryMs >= sec * MS_SEC
// I1 / AP-10: flat, no open trade, never on the exit bar; an OPPOSITE entry needs one full flat bar between.
flatOk(float posSize, int openTrades, int barsSinceExit, bool sameSideAsLast) =>
    posSize == 0 and openTrades == 0 and (na(barsSinceExit) or barsSinceExit >= (sameSideAsLast ? 1 : 2))
// Lucid EOD-trailing MLL floor (LUCID_RULES §8): highest EOD balance - MLL, never above the locked floor.
mllFloor(float hiEod, float mll, float lockedFloor) =>
    math.min(hiEod - mll, lockedFloor)

// ---- envelope (I7: the profile is read ONLY here, for caps + soft loss limits)
float TICK_VALUE = syminfo.mintick * syminfo.pointvalue
int   MPC        = microsPerContract(syminfo.root)
float apStart    = apStartBalance(i_profile)
float apMllUsd   = apMll(i_profile)
float apSoftDL   = apSoftDailyLoss(i_profile)
float apDDBuf    = apDrawdownBuffer(i_profile)

// 03.5 built-ins (L1 soft). Session = the chart symbol's session (CME 18:00 ET roll; C-14, verify OA-2).
// They are BACKSTOPS: the Pine soft stop below fires first with a relay payload; a built-in halt closes
// without one (no alert_message parameter used here) — the relay's strategy sync covers that (Agent 04).
strategy.risk.max_intraday_loss(apSoftDailyLoss(i_profile), strategy.cash)
strategy.risk.max_intraday_filled_orders(i_maxEntries * 2)

if barstate.isfirst and i_entryMode == "BROKER_LIMIT"
    log.warning("ENTRY_MODE = BROKER_LIMIT is deferred to V7 (master prompt Section 9): no orders will be placed.")

var int   dayKey        = na
var int   dayEntries    = 0
var float dayStartNet   = 0.0
var bool  dayHalted     = false
var float eodHigh       = na
var float eodProfit     = 0.0
var int   lastOrderMs   = na
var int   lastExitBar   = na
var int   lastExitDir   = 0
var int   seenClosed    = 0
var float prevPosSize   = 0.0
var int   selfTestFails = 0

// per-bar outputs (debug / self-test)
string entryReject  = ""
int    entryQty     = 0
bool   exitThisBar  = false
int    capMicrosNow = 0

if barstate.isconfirmed
    // -- 1. trading-day roll (18:00 ET): EOD balance for the MLL trail + scaling, reset day counters
    if na(eodHigh)
        eodHigh := apStart
    int dk = tradingDayKey(time)
    bool dayRolled = not na(dayKey) and dk != dayKey
    if na(dayKey) or dk != dayKey
        float eodBal = apStart + strategy.netprofit
        eodHigh     := math.max(eodHigh, eodBal)
        eodProfit   := eodBal - apStart
        dayKey      := dk
        dayEntries  := 0
        dayStartNet := strategy.netprofit
        dayHalted   := false
    // -- 2. bracket / built-in exits that happened since the last bar (I1 flat clock, I5 order clock)
    int nClosed = strategy.closedtrades
    if nClosed > seenClosed
        int k = nClosed - 1
        lastExitBar := strategy.closedtrades.exit_bar_index(k)
        lastExitDir := strategy.closedtrades.size(k) > 0 ? 1 : -1
        int exitMs = strategy.closedtrades.exit_time(k)
        lastOrderMs := na(lastOrderMs) ? exitMs : math.max(lastOrderMs, exitMs)
        seenClosed := nClosed
    // -- 3. envelope numbers
    float dayPnl   = strategy.netprofit - dayStartNet + strategy.openprofit
    float equity   = apStart + strategy.netprofit + strategy.openprofit
    float dayRoom  = apSoftDL + dayPnl
    float mllRoom  = apMllUsd > 0 ? equity - mllFloor(eodHigh, apMllUsd, apLockedFloor(i_profile)) : na
    capMicrosNow  := math.min(apMaxMicros(i_profile), apScalingCap(i_profile, eodProfit), i_maxMicrosTrade)
    if dayPnl <= -apSoftDL
        dayHalted := true
    // -- 4. strategy-initiated exits (I3 flatten, soft daily stop), never within i_minHoldSec of the fill (I6)
    if strategy.position_size != 0
        int posDir = strategy.position_size > 0 ? 1 : -1
        int posQty = int(math.abs(strategy.position_size))
        bool oldEnough = holdOk(strategy.opentrades.entry_time(0), time_close, i_minHoldSec)
        // dayRolled: a position survived past the 18:00 ET roll (e.g. no 16:35 bar printed) -> flatten now
        if (flattenNow(time_close) or dayRolled) and oldEnough
            strategy.close_all(comment = "FLATTEN", alert_message = orderAlert("FLATTEN", posDir, posQty, float(na), float(na), dayRolled ? "I3 stale position after day roll" : "I3 flatten time"))
            lastOrderMs := time_close
            exitThisBar := true
        else if dayHalted and oldEnough
            strategy.close_all(comment = "SOFT_STOP", alert_message = orderAlert("SOFT_STOP", posDir, posQty, float(na), float(na), "softDailyLoss reached"))
            lastOrderMs := time_close
            exitThisBar := true
    // -- 5. entry (03.1 MARKET_ON_CONFIRM at this confirmed 5m close; process_orders_on_close = true)
    if coreSignalLong or coreSignalShort
        int dir = coreSignalLong ? 1 : -1
        float fillPx = close
        float budget = math.min(i_riskPerTrade, dayRoom, na(mllRoom) ? i_riskPerTrade : mllRoom - apDDBuf)
        entryQty := sizeContracts(budget, sigEntryRef, fillPx, sigStop, TICK, TICK_VALUE, capMicrosNow, MPC)
        int barsSinceExit = na(lastExitBar) ? na : bar_index - lastExitBar
        string br = bracketReason(dir, fillPx, sigStop, sigT1, TICK, i_minStopTicks, i_minT1Ticks)
        if i_entryMode != "MARKET_ON_CONFIRM"
            entryReject := "ENTRY_MODE " + i_entryMode + " deferred to V7"
        else if not sessionAllowed(sigTs1m)
            entryReject := "KILLZONE " + sessionName(sigSession) + " disabled"
        else if inManualBlackout(sigTs1m) or inManualBlackout(time_close)
            entryReject := "manual blackout"
        else if entryTimeBlocked(time_close)
            entryReject := "I3 no-entry time"
        else if dayHalted
            entryReject := "softDailyLoss reached"
        else if i_haltAtProfit > 0 and strategy.netprofit >= i_haltAtProfit
            entryReject := "haltAtProfit reached"
        else if dayEntries >= i_maxEntries
            entryReject := "I5 maxEntriesPerSession"
        else if not spacingOk(lastOrderMs, time_close, i_minSecBetween)
            entryReject := "I5 minSecondsBetweenOrders"
        else if exitThisBar or not flatOk(strategy.position_size, strategy.opentrades, barsSinceExit, dir == lastExitDir)
            entryReject := "I1 not flat long enough"
        else if na(sigRrT1) or sigRrT1 < i_rrMin - 1e-9 or sigRrFinal > i_rrMax + 1e-9
            entryReject := "RR band"
        else if br != ""
            entryReject := br
        else if entryQty < 1
            entryReject := "SIZE 0 (budget $" + str.tostring(budget, "#.##") + ")"
        if entryReject == ""
            // Signal column of the TV List of Trades = this comment; tools/pine_parity.py reads sl= / tp=.
            string cmt = "sl=" + str.tostring(sigStop, format.mintick) + "|tp=" + str.tostring(sigT1, format.mintick) + "|ref=" + str.tostring(sigEntryRef, format.mintick)
            if dir > 0
                strategy.entry("LONG", strategy.long, qty = entryQty, comment = cmt, alert_message = orderAlert("ENTRY", 1, entryQty, sigStop, sigT1, sigModel))
                strategy.exit("LONG_BRK", from_entry = "LONG", stop = sigStop, limit = sigT1, comment_loss = "SL", comment_profit = "T1", alert_message = orderAlert("BRACKET", 1, entryQty, sigStop, sigT1, "bracket leg fill"))
            else
                strategy.entry("SHORT", strategy.short, qty = entryQty, comment = cmt, alert_message = orderAlert("ENTRY", -1, entryQty, sigStop, sigT1, sigModel))
                strategy.exit("SHORT_BRK", from_entry = "SHORT", stop = sigStop, limit = sigT1, comment_loss = "SL", comment_profit = "T1", alert_message = orderAlert("BRACKET", -1, entryQty, sigStop, sigT1, "bracket leg fill"))
            dayEntries  += 1
            lastOrderMs := time_close
            if i_selfTest and (hardNoEntry(time_close) or entryQty * MPC > capMicrosNow)
                selfTestFails += 1
                label.new(bar_index, high, "SELFTEST FAIL: entry violates I3/I4", color = color.red, textcolor = color.white, size = size.small)
        else if i_dbgOverlay
            label.new(bar_index, dir > 0 ? low : high, "NO TRADE: " + entryReject, style = dir > 0 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 10), textcolor = color.white, size = size.tiny)
    // -- 6. live invariant assertions (03.8)
    if i_selfTest
        string bad = ""
        if strategy.position_size != 0 and hardFlatten(time)
            bad := bad + "I3 position open after flatten time; "
        if math.abs(strategy.position_size) * MPC > math.max(capMicrosNow, apMaxMicros(i_profile))
            bad := bad + "I4 position above cap; "
        if strategy.opentrades > 1
            bad := bad + "I1 more than one open trade; "
        if prevPosSize != 0 and strategy.position_size != 0 and math.sign(prevPosSize) != math.sign(strategy.position_size)
            bad := bad + "I1/AP-10 reversal without a flat bar; "
        if bad != ""
            selfTestFails += 1
            label.new(bar_index, high, "SELFTEST FAIL: " + bad, color = color.red, textcolor = color.white, size = size.small)
    prevPosSize := strategy.position_size

// ---- 03.8 static assertion cases (oracle numbers from parity/java_signals.csv; run once on the last bar)
selfTestCases() =>
    array<string> fails = array.new<string>()
    // sizing: $250 budget, MNQ tick 0.25 / $0.50, Java cap 5 micros (PORT_MAP S5) -> oracle sizes
    if sizeContracts(250.0, 30636.00, 30638.25, 30674.00, 0.25, 0.5, 5, 1) != 3
        fails.push("G1 size != 3")
    if sizeContracts(250.0, 30847.50, 30847.50, 30889.75, 0.25, 0.5, 5, 1) != 2
        fails.push("G2 size != 2")
    if sizeContracts(250.0, 31008.00, 31008.00, 31000.00, 0.25, 0.5, 5, 1) != 5
        fails.push("09-23 04:04 size != 5 (cap)")
    if sizeContracts(250.0, 30645.00, 30645.00, 30723.00, 0.25, 0.5, 5, 1) != 1
        fails.push("09-28 12:32 size != 1")
    if sizeContracts(250.0, 30000.00, 30000.00, 30150.00, 0.25, 0.5, 5, 1) != 0
        fails.push("oversized stop must give 0")
    if sizeContracts(250.0, 30636.00, 30650.00, 30674.00, 0.25, 0.5, 5, 1) != 3
        fails.push("closer fill must not raise size")
    if sizeContracts(250.0, 30636.00, 30600.00, 30674.00, 0.25, 0.5, 5, 1) != 1
        fails.push("further fill must shrink size")
    if sizeContracts(100000.0, 100.0, 100.0, 99.0, 0.25, 0.5, 30, 10) != 3
        fails.push("mini cap: 30 micros = 3 minis")
    if sizeContracts(float(na), 100.0, 100.0, 99.0, 0.25, 0.5, 5, 1) != 0
        fails.push("na budget must give 0")
    // bracket / I6
    if bracketReason(-1, 30638.25, 30674.00, 30558.00, 0.25, 8, 8) != ""
        fails.push("G1 bracket rejected")
    if bracketReason(1, 100.0, 99.0, 101.0, 0.25, 8, 8) == ""
        fails.push("4-tick stop accepted")
    if bracketReason(1, 100.0, 98.0, 101.0, 0.25, 8, 8) == ""
        fails.push("4-tick T1 accepted")
    if bracketReason(-1, 100.0, 99.0, 98.0, 0.25, 8, 8) == ""
        fails.push("short stop below fill accepted")
    // I3 (ET, DST-safe; 2026-09-25 = Friday, 2026-09-28 = Monday)
    if not hardNoEntry(timestamp(TZ, 2026, 9, 28, 16, 30))
        fails.push("16:30 ET entry allowed")
    if hardNoEntry(timestamp(TZ, 2026, 9, 28, 16, 29))
        fails.push("16:29 ET hard-blocked")
    if hardNoEntry(timestamp(TZ, 2026, 9, 28, 18, 5))
        fails.push("18:05 ET hard-blocked")
    if not hardFlatten(timestamp(TZ, 2026, 9, 28, 16, 40)) or hardFlatten(timestamp(TZ, 2026, 9, 28, 16, 39))
        fails.push("16:40 ET flatten edge")
    if not entryTimeBlocked(timestamp(TZ, 2026, 9, 28, 16, 45))
        fails.push("16:45 ET entry allowed")
    if not flattenNow(timestamp(TZ, 2026, 9, 25, 16, 40))
        fails.push("Friday 16:40 ET not flattening")
    // I5 / I6
    if spacingOk(0, 59 * MS_SEC, 60) or not spacingOk(0, 60 * MS_SEC, 60) or not spacingOk(int(na), 0, 60)
        fails.push("I5 spacing")
    if holdOk(0, 29 * MS_SEC, 30) or not holdOk(0, 30 * MS_SEC, 30)
        fails.push("I6 hold")
    // I1
    if flatOk(1.0, 1, 5, true) or flatOk(0.0, 0, 0, true) or not flatOk(0.0, 0, 1, true)
        fails.push("I1 flat (same side)")
    if flatOk(0.0, 0, 1, false) or not flatOk(0.0, 0, 2, false) or not flatOk(0.0, 0, int(na), false)
        fails.push("I1 flat (opposite side)")
    // MLL emulation + profile envelope sanity (no plan numbers: relations only)
    if mllFloor(1000.0, 100.0, 1005.0) != 900.0 or mllFloor(1200.0, 100.0, 1005.0) != 1005.0
        fails.push("MLL floor")
    if apScalingCap(i_profile, 1e12) < apScalingCap(i_profile, 0.0) or apScalingCap(i_profile, 1e12) > apMaxMicros(i_profile)
        fails.push("scaling cap outside profile max")
    if V6_HARD_NO_ENTRY_HHMM >= V6_HARD_FLATTEN_HHMM
        fails.push("YAML no-entry not before flatten")
    fails

if i_selfTest and barstate.islast
    array<string> f = selfTestCases()
    int nf = f.size() + selfTestFails
    string txt = nf == 0 ? "SELF-TEST PASS (static cases + live invariants) " + BUILD_ID : "SELF-TEST FAIL x" + str.tostring(nf) + ": " + (f.size() > 0 ? array.join(f, "; ") : "see red labels")
    label.new(bar_index, high, txt, color = nf == 0 ? color.green : color.red, textcolor = color.white, style = label.style_label_down, size = size.normal)
