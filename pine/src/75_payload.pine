// =============================================================================
// 75_payload — OWNED BY AGENT 04 (V6 tasks 04.1-04.3). Relay payload builders + the orderAlert hook.
// Sorted BEFORE 80_strategy because Pine resolves functions top-down and 80's six order calls pass
// alert_message = orderAlert(kind, dir, qty, stopPx, tpPx, why). The signature is Agent 03's contract.
//
// Every field below is taken from docs/PLATFORM_FACTS.md (R4; "PF:<line>" = line in that file, which
// cites the vendor URL + retrieval date 2026-11-05). TradingView placeholders such as
// {{strategy.order.contracts}} are NOT expanded inside alert_message (PF:178-180) -> Pine substitutes
// real values here. The alert's Message field is exactly {{strategy.order.alert_message}} (PF:79-81).
//
// Order events (one struct, three builders, 04.3):
//   ENTRY     strategy.entry fill          -> new position + broker-native OSO bracket (I2)
//   BRACKET   strategy.exit fill (SL / T1) -> TV's emulator saw the bracket leg fill. The broker OSO
//             already exits on its own (PF:185-191), so this event must NOT send a new order: it is a
//             sync-only message the relay REJECTS (CrossTrade: strategy_exit_block=true rejects any
//             payload whose prev_market_position != flat, PF:217-218, the documented pairing for
//             broker-managed exits PF:229-232). See RELAY_SETUP.md §3 for the decision record.
//   FLATTEN   strategy.close_all (I3 16:40 ET / day roll) -> relay flatten command
//   SOFT_STOP strategy.close_all (soft daily loss)        -> relay flatten command
// Never returns "" (an empty alert_message fails the alert, PF:81-83; lint L10 enforces the hook).
// =============================================================================

type OrderEvent
    string kind
    int    dir
    int    qty
    float  stopPx
    float  tpPx
    string why

const string RELAY_SECRET_PH = "<RELAY_SECRET>"
const string RELAY_DRYRUN_PH = "<DRY_RUN>"
const string PAYLOAD_TAG     = "LucidICT_v6"

// ---- helpers
pxStr(float p) =>
    str.tostring(p, format.mintick)
noSpaces(string s) =>
    str.replace_all(str.replace_all(s, " ", ""), "\t", "")
// relay-safe free text (no field separators / quotes / newlines inside a value)
safeTxt(string s) =>
    str.replace_all(str.replace_all(str.replace_all(str.replace_all(s, ";", ","), "=", ":"), "\n", " "), '"', "'")
accountList(string raw) =>
    array<string> out = array.new<string>()
    array<string> parts = str.split(noSpaces(raw), ",")
    for a in parts
        if str.length(a) > 0
            out.push(a)
    out
maskedAccounts(int n) =>
    array<string> out = array.new<string>()
    for i = 1 to math.max(n, 1)
        out.push("<ACCOUNT_" + str.tostring(i) + ">")
    array.join(out, ",")
// relay instrument (PF:145-147 CrossTrade accepts MNQ1!; PF:341 PickMyTrade uses the root;
// PF:356 TradersPost needs a dated contract)
relayInstrument(string relay) =>
    string s = noSpaces(i_relaySymbol)
    str.length(s) > 0 ? s : relay == "PICKMYTRADE" ? syminfo.root : syminfo.ticker
// LIVE only when the owner switched it on AND replaced the placeholders (else DRY RUN: the relay
// rejects key=<DRY_RUN> as "Secret key missing, invalid, or inactive", PF:142-143)
relayLive() =>
    string k = noSpaces(i_relaySecret)
    i_tradingEnabled and str.length(k) > 0 and k != RELAY_SECRET_PH and not str.contains(i_relayAccounts, "<ACCOUNT_")
buildTag(string kind) =>
    PAYLOAD_TAG + "-" + BUILD_ID + "-" + kind

// ---- CrossTrade (default). Semicolon format, every line ends with ";" (PF:137), text/plain (PF:56).
ctLine(string k, string v) =>
    k + "=" + v + ";\n"
ctPayload(OrderEvent e, string sec, string accounts) =>
    string side  = e.dir > 0 ? "BUY" : "SELL"
    string xside = e.dir > 0 ? "SELL" : "BUY"
    string pos   = e.dir > 0 ? "long" : "short"
    string head  = ctLine("key", sec) // PF:142
    string acct  = ctLine("account", accounts) + ctLine("instrument", relayInstrument("CROSSTRADE")) // PF:144-147, fan-out PF:241
    string tail  = ctLine("strategy_tag", buildTag(e.kind)) + ctLine("destination", "tradovate") // tag accepted-but-ignored PF:154 (Alert History shows it, D8); PF:140-141
    string p = ""
    if e.kind == "ENTRY"
        p := head + ctLine("command", "PLACE") + acct + ctLine("action", side) + ctLine("qty", str.tostring(e.qty)) + ctLine("order_type", "MARKET") + ctLine("tif", "DAY") + ctLine("take_profit", pxStr(e.tpPx)) + ctLine("stop_loss", pxStr(e.stopPx)) + ctLine("flatten_first", "true") + ctLine("sync_strategy", "true") + ctLine("market_position", pos) + ctLine("prev_market_position", "flat") + ctLine("target_quantity", str.tostring(e.qty)) + ctLine("out_of_sync", "flatten") + ctLine("strategy_exit_block", "true") + tail
        // B2 minimal V6 entry PF:159-177; absolute OSO prices PF:185-198; flatten_first PF:155 + PF:229; sync PF:215-223
    else if e.kind == "BRACKET"
        // sync-only, REJECTED by strategy_exit_block (prev_market_position != flat, PF:217-218). Even if it
        // were evaluated, out_of_sync=flatten on an already-flat broker withholds the order (PF:219-221).
        p := head + ctLine("command", "PLACE") + acct + ctLine("action", xside) + ctLine("qty", str.tostring(e.qty)) + ctLine("order_type", "MARKET") + ctLine("tif", "DAY") + ctLine("sync_strategy", "true") + ctLine("market_position", "flat") + ctLine("prev_market_position", pos) + ctLine("target_quantity", "0") + ctLine("out_of_sync", "flatten") + ctLine("strategy_exit_block", "true") + tail
    else
        // FLATTEN / SOFT_STOP: `flatten` is a supported Tradovate command (PF:149-152); no sync fields so the
        // sync gate / exit block never withhold a risk-reducing close.
        p := head + ctLine("command", "FLATTEN") + acct + tail
    p

// ---- PickMyTrade (fallback, JSON, token in the body; fields PF:332-336). CONSERVATIVE-UNVERIFIED: no
// strategy sync (PF:334), bracket OSO-ness not stated (PF:335).
pmtPayload(OrderEvent e, string sec, string accounts) =>
    array<string> accs = str.split(accounts, ",")
    string first = accs.size() > 0 ? accs.get(0) : ""
    array<string> extra = array.new<string>()
    if accs.size() > 1
        for i = 1 to accs.size() - 1
            extra.push('{"token":"' + sec + '","account_id":"' + accs.get(i) + '","risk_percentage":0,"quantity_multiplier":1}')
    string common = '"symbol":"' + relayInstrument("PICKMYTRADE") + '","date":"' + str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"'
    string auth = ',"token":"' + sec + '","account_id":"' + first + '"' + (extra.size() > 0 ? ',"multiple_accounts":[' + array.join(extra, ",") + ']' : "")
    string p = ""
    if e.kind == "ENTRY"
        p := '{' + common + ',"data":"' + (e.dir > 0 ? "buy" : "sell") + '","quantity":' + str.tostring(e.qty) + ',"order_type":"MKT","tp":' + pxStr(e.tpPx) + ',"sl":' + pxStr(e.stopPx) + ',"pyramid":false,"reverse_order_close":false' + auth + '}'
    else if e.kind == "BRACKET"
        // no documented sync gate -> make it non-actionable: no token (auth is the body token, PF:333) and
        // no "data" action. The broker-side tp/sl placed by PickMyTrade owns the exit.
        p := '{' + common + ',"note":"' + buildTag("BRACKET_FILL_IGNORE") + '"}'
    else
        p := '{' + common + ',"data":"close","quantity":' + str.tostring(e.qty) + auth + '}'
    p

// ---- TradersPost (fallback, JSON; fields PF:350-353; secret lives in the webhook address PF:351)
tpPayload(OrderEvent e) =>
    string tk = '"ticker":"' + relayInstrument("TRADERSPOST") + '"'
    string p = ""
    if e.kind == "ENTRY"
        p := '{' + tk + ',"action":"' + (e.dir > 0 ? "buy" : "sell") + '","sentiment":"' + (e.dir > 0 ? "long" : "short") + '","quantity":' + str.tostring(e.qty) + ',"orderType":"market","timeInForce":"day","takeProfit":{"limitPrice":' + pxStr(e.tpPx) + '},"stopLoss":{"type":"stop","stopPrice":' + pxStr(e.stopPx) + '}}'
    else if e.kind == "BRACKET"
        // `ticker` is REQUIRED (PF:350) -> omitted on purpose: TradersPost rejects it, the attached
        // broker legs own the exit.
        p := '{"note":"' + buildTag("BRACKET_FILL_IGNORE") + '"}'
    else
        p := '{' + tk + ',"action":"exit","sentiment":"flat","cancel":true}'
    p

relayPayload(OrderEvent e, string sec, string accounts) =>
    i_relay == "PICKMYTRADE" ? pmtPayload(e, sec, accounts) : i_relay == "TRADERSPOST" ? tpPayload(e) : ctPayload(e, sec, accounts)

// ---- THE HOOK (Agent 03 signature). kind: ENTRY | BRACKET | FLATTEN | SOFT_STOP. dir +1/-1. Absolute prices.
orderAlert(string kind, int dir, int qty, float stopPx, float tpPx, string why) =>
    OrderEvent e = OrderEvent.new(kind, dir, qty, stopPx, tpPx, safeTxt(why))
    array<string> accs = accountList(i_relayAccounts)
    string sec = relayLive() ? noSpaces(i_relaySecret) : RELAY_DRYRUN_PH
    string p = relayPayload(e, sec, array.join(accs, ","))
    if i_relayLog
        // masked copy only: the real secret / account names never reach Pine Logs (R5)
        log.info("{0}", "[" + buildTag(kind) + " why=" + e.why + "]\n" + relayPayload(e, RELAY_SECRET_PH, maskedAccounts(accs.size())))
    str.length(p) > 0 ? p : PAYLOAD_TAG + " " + BUILD_ID + " " + kind
